---import {withBase} from '../lib/urls';

import '../styles/global.css';
import '../styles/web-production-refinement.css';
import '../styles/learning-colors.css';
import {brand} from '../data/public';
import ManzoSignature from '../components/ManzoSignature.astro';
import '../styles/manzo-signature.css';
import '../styles/contact-header.css';
import '../styles/legal-links.css';
import ContactHeader from '../components/ContactHeader.astro';
import professionalStyles from '../styles/professional.css?url';
import whiteEcosystemStyles from '../styles/white-ecosystem.css?url';
import editorialStyles from '../styles/editorial-v3.css?url';
import academyStyles from '../styles/academy-v4.css?url';
import publicRefinementStyles from '../styles/public-refinement-v4.css?url';
const {title='RISTO-LAB',description}=Astro.props;
const descriptions:Record<string,string>={"Formazione per l'ospitalità":"RISTO-LAB: formazione per il servizio in sala, 26 unità, risorse libere e strumenti operativi per la ristorazione.","Formazione":"Percorsi didattici per il servizio in sala, Menu Engineering e sicurezza, con esercitazioni e laboratori.","Risorse":"Risorse libere, presentazioni, guide e materiali per docenti e professionisti dell’ospitalità.","Programmi":"Esplora il curriculum del servizio in sala e lo stato delle unità formative.","Premium":"Progetto di percorsi formativi approfonditi, in progettazione.","Aziende":"Progetto di formazione per gruppi di lavoro e imprese dell’ospitalità, da validare."};
const pageDescription=description||descriptions[title]||('RISTO-LAB — '+String(title)+': informazioni e risorse per la formazione nell’ospitalità.');
const nav=[[withBase('/'),'Home'],[withBase('/formazione/'),'Formazione'],[withBase('/programmi/'),'Programmi'],[withBase('/risorse/'),'Risorse'],[withBase('/premium/'),'Premium'],[withBase('/aziende/'),'Aziende'],[withBase('/esperienza/'),'Chi siamo'],[withBase('/instructor/professional-suite/'),'Strumenti'],[withBase('/area-docente/'),'Instructor']];
---
<!doctype html><html lang="it"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={pageDescription}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site).href}/><link rel="icon" href={withBase("/favicon.svg")}/><title>{String(title).replace(/\.$/,'')} · RISTO-LAB</title><style is:global>body.rl-public .rl-desktop-nav a,body.rl-public .rl-mobile-links a{min-height:44px;display:inline-flex;align-items:center;border-radius:999px}body.rl-public .rl-mobile-links a{display:flex;white-space:normal}body.rl-public .rl-mobile-menu summary{border-radius:999px}body.rl-public .rl-mobile-menu .rl-mobile-links{max-width:calc(100vw - 32px);max-height:70vh;overflow:auto;border-radius:18px}body.rl-public .rl-desktop-nav a:focus-visible,body.rl-public .rl-mobile-menu a:focus-visible{outline:2px solid currentColor;outline-offset:2px}@media(max-width:1050px){body.rl-public .rl-desktop-nav{display:none!important}body.rl-public .rl-mobile-menu{display:block!important}}</style></head><body class="rl-public"><link rel="stylesheet" href={professionalStyles}/><link rel="stylesheet" href={whiteEcosystemStyles}/><link rel="stylesheet" href={editorialStyles}/><link rel="stylesheet" href={academyStyles}/><link rel="stylesheet" href={publicRefinementStyles}/><a class="skip" href="#contenuto">Vai al contenuto</a><header class="topbar"><div class="wrap toprow"><a class="brand" href={withBase("/")}><img class="risto-brand-symbol" src={withBase("/brand/risto-lab-icon.webp")} width="42" height="42" alt="" aria-hidden="true"/><span class="risto-wordmark"><b>Risto-<span class="lab-accent">Lab</span></b><small>HOSPITALITY TRAINING</small></span></a><nav class="rl-desktop-nav" aria-label="Navigazione principale">{nav.map(([href,label])=><a href={href} class:list={[label==='Instructor'&&'rl-nav-cta']} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}</nav><details class="rl-mobile-menu"><summary>Menu <span aria-hidden="true">☰</span></summary><nav class="rl-mobile-links" aria-label="Navigazione mobile">{nav.map(([href,label])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}<a href={withBase('/contatti/')}>Contatti</a></nav></details></div><ContactHeader/></header><main id="contenuto"><slot/></main><footer class="footer"><div class="wrap"><div class="rl-footer-brand"><span class="academy-footer-logo"><img src={withBase("/brand/risto-lab-icon.webp")} width="54" height="54" alt="" loading="lazy"/><span><strong>Risto-<span class="lab-accent">Lab</span></strong><small>HOSPITALITY TRAINING</small></span></span><span>{brand.descriptor} · by {brand.creator}</span></div><div class="rl-legal-footer"><nav class="rl-legal-links" aria-label="Informazioni legali"><a href={withBase('/legal/')}>Note legali</a><a href={withBase('/privacy/')}>Privacy</a><a href={withBase('/cookie/')}>Cookie</a><a href={withBase('/ai-act/')}>Trasparenza AI</a></nav><p>Progetto divulgativo indipendente · Nessuna pubblicità · Materiali anche assistiti da AI</p></div><ManzoSignature/></div></footer></body></html>
