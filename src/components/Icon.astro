---
import {iconPaths,type IconName} from '../lib/icons';interface Props{name:IconName;size?:number}const {name,size=18}=Astro.props;
---
<svg class="ui-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={iconPaths[name]}/></svg>
