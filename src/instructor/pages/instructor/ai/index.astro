---
import Hub from '../../../../layouts/Instructor.astro';import {units} from '../../../data/catalog';import {aiTasks} from '../../../../lib/ai-context';import {aiProvider} from '../../../../lib/ai-provider';import {withBase} from '../../../../lib/urls';
---
<Hub title="RISTO-LAB AI"><p class="eyebrow">Preparare con il contesto</p><h1>RISTO-LAB AI</h1><p class="lead">Il tuo assistente per la formazione nella ristorazione</p><p class="prose muted">Prepara una richiesta collegata al tuo lavoro e continua in ChatGPT. Qui componi e rivedi il testo: le risposte arrivano nel servizio esterno.</p><p id="ai-orientation" class="notice" role="status"></p><a id="ai-return" class="text-link" href={withBase('/instructor/')}>Torna alla Home</a><form id="ai-form" class="ai-composer"><div class="metadata-fields"><label>Unità<select id="ai-unit"><option value="">Nessuna unità / richiesta trasversale</option>{units.map(u=><option value={u.id}>{String(u.order).padStart(2,'0')} · {u.title}</option>)}</select></label><label>Materiale<select id="ai-resource"><option value="">Nessun materiale selezionato</option></select></label><label>Cosa vuoi fare?<select id="ai-task" aria-label="Cosa vuoi fare?">{Object.entries(aiTasks).map(([value,title])=><option value={value}>{title}</option>)}</select></label></div><label>La tua richiesta<textarea id="ai-request" rows="4" maxlength="6000" placeholder="Es. Prepara un’attività pratica di 15 minuti per studenti A2–B1"></textarea></label><label>Richiesta pronta da copiare<textarea id="ai-preview" rows="13" readonly></textarea></label><div class="actions"><button id="ai-copy" type="button">Copia richiesta</button><a class="button secondary" id="ai-launch" href={aiProvider.launchUrl||aiProvider.fallbackUrl} target="_blank" rel="noopener noreferrer">Apri ChatGPT ↗</a></div><p id="ai-copy-status" role="status" aria-live="polite"></p><p class="muted prose">{aiProvider.instructions}</p><p class="muted prose">Nessun contenuto viene inserito automaticamente nella lezione. Per contenuti normativi verifica sempre le fonti collegate.</p><p><a class="text-link" href={withBase('/instructor/normativa/')}>Consulta le fonti normative</a></p></form><script>import '../../../../lib/ai-client';</script></Hub>
