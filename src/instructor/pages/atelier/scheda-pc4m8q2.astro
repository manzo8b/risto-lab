---
import '../../../styles/global.css';
import '../../../styles/learning-colors.css';
import {withBase} from '../../../lib/urls';

const lessons=[
 {phase:'01',name:'Diagnosi del bisogno',minutes:20,kind:'Analisi',result:'Fabbisogno e vincoli del committente'},
 {phase:'02',name:'Leggere le fonti con metodo',minutes:55,kind:'Normativa',result:'Matrice requisiti e domande aperte'},
 {phase:'03',name:'Obiettivi osservabili',minutes:50,kind:'Progettazione',result:'Obiettivi allineati alle prove'},
 {phase:'04',name:'Caso applicativo HSE',minutes:45,kind:'Laboratorio',result:'Storyboard di microlezione'},
 {phase:'05',name:'Prototipazione con strumenti digitali',minutes:60,kind:'Sviluppo',result:'Slide, scenario e quiz motivato'},
 {phase:'06',name:'Simulazione e feedback',minutes:50,kind:'Verifica',result:'Microlezione provata con pari'},
 {phase:'07',name:'Controllo qualità delle fonti',minutes:45,kind:'Revisione',result:'Checklist normativa e AI'},
 {phase:'08',name:'Restituzione e piano di transfer',minutes:35,kind:'Riesame',result:'Kit finale e follow-up'},
];
const quiz=[
 {q:'Quale passo viene prima della produzione delle slide?',choices:['Scegliere il template grafico','Definire destinatari, bisogni e obiettivi','Stampare il questionario di gradimento'],answer:1,why:'Il progetto nasce dall’analisi del fabbisogno, non dal formato dei materiali.'},
 {q:'Una diapositiva dice che una firma rende sempre valido un corso obbligatorio. Come procedi?',choices:['La mantieni perché è un messaggio semplice','La pubblichi con la dicitura “probabilmente”','Verifichi requisiti specifici dell’Accordo e correggi l’affermazione'],answer:2,why:'L’accuratezza normativa richiede fonte vigente e verifica delle condizioni del percorso.'},
 {q:'Quale risultato dimostra meglio l’apprendimento in una microlezione HSE?',choices:['Il partecipante svolge un compito simulato con criteri chiari','Il docente proietta più di 20 slide','Il partecipante dice che il corso è interessante'],answer:0,why:'La prestazione osservabile è più vicina all’obiettivo della competenza; il gradimento ha un altro scopo.'},
 {q:'La verifica sul lavoro dopo il corso coincide con il quiz finale?',choices:['Sempre','No: accerta il trasferimento nelle attività reali in tempi successivi','Sì, se il quiz è digitale'],answer:1,why:'La verifica di apprendimento e la verifica dell’efficacia sul lavoro sono momenti e misure distinti.'}
];
const sources=[
 {label:'D.Lgs. 81/2008 — testo vigente (Normattiva)',url:'https://www.normattiva.it/eli/id/2008/04/30/008G0104/CONSOLIDATED'},
 {label:'Accordo Stato-Regioni 17 aprile 2025, n. 59/CSR — Ministero',url:'https://www.lavoro.gov.it/temi-e-priorita-salute-e-sicurezza/focus/accordo-stato-regioni-17042025-allegato'},
 {label:'FAQ ministeriali sull’Accordo — marzo 2026',url:'https://www.lavoro.gov.it/temi-e-priorita-salute-e-sicurezza/focus/faq-accordo-stato-regioni-27032026'},
 {label:'CDC — Quality Training Standards',url:'https://www.cdc.gov/training-development/php/qts/'},
];
---
<!doctype html>
<html lang="it">
<head>
 <meta charset="utf-8"/>
 <meta name="viewport" content="width=device-width, initial-scale=1"/>
 <meta name="robots" content="noindex,nofollow,noarchive,nosnippet"/>
 <meta name="googlebot" content="noindex,nofollow,noarchive,nosnippet"/>
 <meta name="description" content="Proposta dimostrativa di progettazione della formazione aziendale HSE e project work."/>
 <meta name="referrer" content="strict-origin-when-cross-origin"/>
 <link rel="icon" href={withBase('/favicon.svg')}/>
 <title>HSE Learning Lab · Proposta dimostrativa RISTO-LAB</title>
</head>
<body class="case-portfolio">
 <a class="skip" href="#documento">Vai al progetto</a>
 <header class="mini-header">
  <div class="case-container brand-line">
   <a href={withBase('/')} class="case-brand">RISTO<span>—</span>LAB <small>Learning Design · Portfolio</small></a>
   <div class="version">Dossier di progetto <span>v1.0 · 29/10/2026</span></div>
  </div>
 </header>
 <main id="documento" class="case-container">
  <section class="case-hero">
   <p class="kicker">Proposta autonoma · Studio progettuale non commissionato</p>
   <h1>CONSILIA <em>HSE Learning Lab</em></h1>
   <p class="hero-subtitle">Progettare la sicurezza che si apprende</p>
   <p class="hero-intro">Un esempio completo di instructional design per professionisti della formazione HSE: dal fabbisogno alla microprogettazione, dalle fonti normative alla verifica dell’apprendimento e del trasferimento.</p>
   <div class="hero-actions">
    <a class="case-btn primary" href="#progetto">Esamina la proposta</a>
    <a class="case-btn light" href="#project-work">Prova il project work</a>
    <button class="case-btn light" id="print-project" type="button">Stampa il dossier</button>
   </div>
   <div class="hero-stats">
    <div><strong>8 ore</strong><small>due laboratori da 4 ore</small></div>
    <div><strong>4 settimane</strong><small>preparazione indicativa</small></div>
    <div><strong>30 giorni</strong><small>follow-up proposto</small></div>
    <div><strong>1 kit</strong><small>modello didattico riutilizzabile</small></div>
   </div>
  </section>

  <aside class="status-note" role="note">
   <strong>Ambito e trasparenza.</strong> Questo lavoro è un <strong>portfolio dimostrativo indipendente</strong> realizzato da RISTO-LAB. Non è stato commissionato, approvato o patrocinato da Consilia CFO S.r.l. Tutti gli scenari sono sintetici. Non vengono divulgati dati, documenti interni o loghi aziendali. Non costituisce corso HSE obbligatorio né rilascia attestati. <strong>La pagina è non elencata, ma non protetta da autenticazione.</strong>
  </aside>

  <div class="case-contents" aria-label="Indice del dossier">
   <a href="#progetto"><span>01</span> Impianto progettuale</a>
   <a href="#programma"><span>02</span> Programma e tempi</a>
   <a href="#project-work"><span>03</span> Project work interattivo</a>
   <a href="#valutazione"><span>04</span> Valutazioni e deliverable</a>
   <a href="#fonti"><span>05</span> Fonti e limiti</a>
  </div>

  <section id="progetto" class="case-section">
   <div class="section-kicker"><span>01</span> Progettazione didattica</div>
   <h2>Dal bisogno al comportamento osservabile</h2>
   <p class="reading-lead">La proposta risponde a un'esigenza ipotetica, da verificare con l'azienda: rendere più omogenea, controllabile e partecipativa la progettazione dei corsi HSE rivolti alle imprese clienti.</p>
   <div class="three-cards">
    <article class="method-card blue"><div class="method-id">A</div><h3>Analizzare</h3><p>Interviste, destinatari, mansioni, documenti autorizzati, vincoli del corso e competenze pregresse. Prima si verifica se il problema è realmente formativo.</p></article>
    <article class="method-card teal"><div class="method-id">B</div><h3>Progettare</h3><p>Obiettivi misurabili, vincoli normativi, macro- e microprogettazione, sequenza delle attività, materiale docente e feedback.</p></article>
    <article class="method-card clay"><div class="method-id">C</div><h3>Verificare</h3><p>Prove finali e osservazione del trasferimento. Si distinguono soddisfazione, apprendimento e comportamenti lavorativi.</p></article>
   </div>
   <h3>Destinatari e governance</h3>
   <p><strong>Gruppo ipotizzato:</strong> 8–12 progettisti, docenti, referenti HSE e responsabili della formazione. <strong>Requisiti iniziali:</strong> esperienza nella costruzione o conduzione di percorsi aziendali e disponibilità a lavorare su casi fittizi. <strong>Responsabilità:</strong> il progettista cura metodo e materiali; un professionista HSE qualificato verifica le parti tecniche e la loro eventuale applicazione ai percorsi obbligatori.</p>
   <h3>Cinque risultati di apprendimento</h3>
   <ol class="outcomes">
    <li>Individuare le fonti ufficiali pertinenti al percorso formativo.</li>
    <li>Scrivere obiettivi di apprendimento formulati come comportamenti osservabili.</li>
    <li>Trasformare una disposizione normativa in un caso didattico coerente.</li>
    <li>Revisionare criticamente una bozza generata con strumenti AI.</li>
    <li>Progettare prove di apprendimento e indicatori per verificare l’efficacia nel tempo.</li>
   </ol>
  </section>

  <section id="programma" class="case-section">
   <div class="section-kicker"><span>02</span> Architettura e durata</div>
   <h2>Due giornate, otto attività</h2>
   <p>Il programma comprende 480 minuti complessivi, comprese due pause di 10 minuti. Le durate sono ipotesi didattiche di un laboratorio metodologico <strong>non certificante</strong>, non minimi normativi di corsi HSE.</p>
   <div class="agenda-head"><span>Incontro 1 · 240 minuti</span><span>Incontro 2 · 240 minuti</span></div>
   <div class="agenda">
    {lessons.slice(0,4).map(x=><article class="agenda-row"><div class="duration">{x.minutes}<small>min</small></div><div><p class="lesson-kind">{x.kind}</p><h3>{x.phase}. {x.name}</h3><p><strong>Output:</strong> {x.result}</p></div></article>)}
    <div class="break-row">Pausa guidata tra le unità: 10 min</div>
    {lessons.slice(4).map(x=><article class="agenda-row"><div class="duration">{x.minutes}<small>min</small></div><div><p class="lesson-kind">{x.kind}</p><h3>{x.phase}. {x.name}</h3><p><strong>Output:</strong> {x.result}</p></div></article>)}
    <div class="break-row">Pausa guidata tra le unità: 10 min</div>
   </div>
   <p class="aside-text">La scansione finale delle pause e degli incontri va definita insieme a Consilia; la distribuzione qui rappresenta un modello progettuale, non un calendario concordato.</p>
  </section>

  <section id="project-work" class="case-section">
   <div class="section-kicker"><span>03</span> Prototipo formativo</div>
   <h2>Project work: una microlezione HSE in 25 minuti</h2>
   <p class="reading-lead">Scenario fittizio: il quasi-incidente viene trasformato in un esercizio di progettazione. Lo scopo non è simulare una consulenza RSPP, ma mostrare come si sviluppa una competenza formativa osservabile.</p>
   <div class="work-brief">
    <div><strong>Destinatari del prototipo</strong><p>Progettisti e formatori HSE</p></div>
    <div><strong>Competenza da dimostrare</strong><p>Progettare una segnalazione efficace basata su fatti verificabili</p></div>
    <div><strong>Prova osservabile</strong><p>Selezionare i fatti, distinguere ipotesi e motivare un'azione compatibile col proprio ruolo</p></div>
   </div>
   <h3>Storyboard didattico — cinque scene</h3>
   <div class="storyboard">
    <article><span>00–04'</span><h4>Il problema</h4><p>In un corridoio di servizio un cavo attraversa il passaggio; una persona si ferma prima di inciampare.</p></article>
    <article><span>04–08'</span><h4>La telefonata</h4><p>Giulia racconta ad Arianna: «Se nessuno è caduto, non c'è niente da segnalare, vero?»</p></article>
    <article><span>08–13'</span><h4>Verifica la fonte</h4><p>I partecipanti riconoscono il principio preventivo e consultano il D.Lgs. 81/2008, in particolare gli articoli 15, 19 e 20.</p></article>
    <article><span>13–21'</span><h4>Simula la scelta</h4><p>Il gruppo sceglie un comportamento e prepara una segnalazione chiara, senza interventi tecnici non autorizzati.</p></article>
    <article><span>21–25'</span><h4>Debrief</h4><p>Il docente osserva la qualità del ragionamento, chiarisce gli errori e propone un indicatore di trasferimento.</p></article>
   </div>
   <div class="decision-panel" id="esercizio">
    <div class="decision-kicker">Prova interattiva · 2 minuti</div>
    <h3>«Pronto, Arianna! Ma davvero dobbiamo segnalare anche questo?»</h3>
    <p class="dialogue"><strong>Giulia:</strong> «C'era un cavo di traverso, una collega l'ha evitato. Non è successo nulla, quindi lasciamo perdere?»</p>
    <p class="dialogue"><strong>Arianna:</strong> «Prima distinguiamo quello che sappiamo. E poi chi avvisiamo?»</p>
    <fieldset class="choice-set" id="practice-choices">
     <legend>Quale risposta proporresti?</legend>
     <label><input type="radio" name="scenario" value="a"/> Nessun infortunio, nessuna segnalazione necessaria.</label>
     <label><input type="radio" name="scenario" value="b"/> Segnalare secondo la procedura, limitare l’esposizione nei limiti del proprio ruolo e coinvolgere il referente competente.</label>
     <label><input type="radio" name="scenario" value="c"/> Spostare subito ogni apparecchio e intervenire sui collegamenti elettrici, anche senza competenza.</label>
    </fieldset>
    <button class="case-btn primary" id="check-scenario" type="button">Verifica la decisione</button>
    <p id="scenario-feedback" class="feedback" role="status" aria-live="polite"></p>
   </div>
   <h3>Quiz: progettare prima di insegnare</h3>
   <form id="work-quiz">
    {quiz.map((q,i)=><fieldset class="quiz-question" data-answer={q.answer} data-explanation={q.why}>
     <legend>{i+1}. {q.q}</legend>
     {q.choices.map((choice,j)=><label><input type="radio" name={'q'+i} value={j}/>{choice}</label>)}
     <p class="item-feedback" role="status" aria-live="polite"></p>
    </fieldset>)}
    <div class="form-actions"><button type="button" class="case-btn primary" id="check-quiz">Correggi e spiega</button><button type="reset" class="case-btn light">Ricomincia</button></div>
    <p id="quiz-total" class="feedback" role="status" aria-live="polite"></p>
   </form>
   <details class="debrief"><summary>Apri la rubrica del facilitatore</summary>
    <p>Per ciascun criterio assegna 0 = assente; 1 = parziale; 2 = completo e motivato. La scala è un esempio interno, non un esame valido ai fini di un corso obbligatorio.</p>
    <ul><li>Riconosce almeno due fatti osservabili.</li><li>Distingue l'osservazione dalla supposizione.</li><li>Indica una segnalazione nel proprio ruolo.</li><li>Cita una fonte primaria pertinente.</li><li>Propone una verifica successiva realistico-osservabile.</li></ul>
   </details>
  </section>

  <section id="valutazione" class="case-section">
   <div class="section-kicker"><span>04</span> Evidenze e riesame</div>
   <h2>Che cosa consegniamo e come valutiamo</h2>
   <div class="two-columns">
    <div class="surface-card">
     <h3>Kit di progetto</h3>
     <ul><li>Brief dell’analisi dei fabbisogni.</li><li>Macroprogetto di 8 ore con cronoprogramma.</li><li>Microprogetto e storyboard di un'unità HSE.</li><li>Slide e testi del caso sintetico.</li><li>Domande con motivazioni e rubrica.</li><li>Checklist delle fonti e validazione normativa.</li><li>Modello di follow-up e miglioramento.</li></ul>
    </div>
    <div class="surface-card">
     <h3>Tre livelli di valutazione</h3>
     <ol><li><strong>In ingresso:</strong> prerequisiti e aspettative; analisi dei materiali autorizzati.</li><li><strong>In uscita:</strong> prova finale su qualità del progetto e applicazione simulata.</li><li><strong>A 30 giorni:</strong> uso del modello da parte del team e valutazione delle criticità reali.</li></ol>
     <p>Non si attribuiscono automaticamente alla formazione riduzioni di infortuni o altri risultati non verificati.</p>
    </div>
   </div>
   <h3>Timeline di sviluppo (ipotesi)</h3>
   <div class="timeline">
    <div><strong>Settimana 1</strong><span>Fabbisogno e documentazione</span></div>
    <div><strong>Settimana 2</strong><span>Progettazione e test</span></div>
    <div><strong>Settimana 3</strong><span>Sviluppo e revisione HSE</span></div>
    <div><strong>Settimana 4</strong><span>Pilotaggio ed erogazione</span></div>
    <div><strong>+30 giorni</strong><span>Follow-up e riesame</span></div>
   </div>
   <p>La qualità della proposta si valuta sulla coerenza tra bisogno, obiettivi, attività e prove, non sul numero di slide o sull'effetto scenico.</p>
  </section>

  <section id="fonti" class="case-section">
   <div class="section-kicker"><span>05</span> Riferimenti istituzionali</div>
   <h2>Fonti aperte, condizioni chiare</h2>
   <p>I collegamenti ufficiali servono a verificare disposizioni e aggiornamenti. Il progetto si limita alla progettazione didattica dimostrativa: i requisiti HSE specifici vanno controllati da professionisti competenti prima di qualsiasi applicazione obbligatoria.</p>
   <ul class="source-list">{sources.map(src=><li><a href={src.url} rel="noopener noreferrer" target="_blank">{src.label} ↗</a></li>)}</ul>
   <p class="legal-note">Nota editoriale: questo documento non dichiara un rapporto contrattuale con Consilia CFO, non documenta corsi effettivamente erogati da Consilia, non usa contenuti riservati e non certifica conformità di programmi formativi regolati.</p>
  </section>
 </main>
 <footer class="mini-footer"><div class="case-container"><strong>RISTO—LAB</strong><span>Progettazione didattica · Dossier dimostrativo · 2026</span></div></footer>
 <script>
 const scenarioButton=document.querySelector<HTMLButtonElement>('#check-scenario');
 scenarioButton?.addEventListener('click',()=>{
  const choice=document.querySelector<HTMLInputElement>('input[name="scenario"]:checked');
  const feedback=document.querySelector<HTMLElement>('#scenario-feedback');
  if(!feedback)return;
  if(!choice){feedback.textContent='Seleziona una risposta prima di verificare.';return;}
  feedback.textContent=choice.value==='b'
    ?'Scelta appropriata nel caso: si segnalano i fatti e si richiede una gestione competente, senza improvvisare interventi.'
    :'Da riconsiderare: il quasi-incidente è un segnale utile. Occorre rispettare ruoli, procedure e competenze.';
  feedback.dataset.verdict=choice.value==='b'?'correct':'review';
 });
 const form=document.querySelector<HTMLFormElement>('#work-quiz');
 const rows=Array.from(document.querySelectorAll<HTMLFieldSetElement>('.quiz-question'));
 document.querySelector('#check-quiz')?.addEventListener('click',()=>{
  let score=0,answered=0;
  rows.forEach((row,i)=>{
   const select=row.querySelector<HTMLInputElement>('input[name="q'+i+'"]:checked');
   const feedback=row.querySelector<HTMLElement>('.item-feedback');
   if(!feedback)return;
   if(!select){feedback.textContent='Domanda senza risposta.';return;}
   answered++;
   const correct=Number(select.value)===Number(row.dataset.answer);
   if(correct)score++;
   feedback.textContent=(correct?'Corretto. ':'Da rivedere. ')+(row.dataset.explanation||'');
   feedback.dataset.verdict=correct?'correct':'review';
  });
  const summary=document.querySelector<HTMLElement>('#quiz-total');
  if(summary)summary.textContent='Domande completate '+answered+'/4 · risposte corrette '+score+'/4. Verifica dimostrativa, non certificante.';
 });
 form?.addEventListener('reset',()=>{
  rows.forEach(row=>{const f=row.querySelector<HTMLElement>('.item-feedback');if(f){f.textContent='';delete f.dataset.verdict;}});
  const total=document.querySelector<HTMLElement>('#quiz-total');if(total)total.textContent='';
 });
 document.querySelector('#print-project')?.addEventListener('click',()=>window.print());
 </script>
</body>
</html>
