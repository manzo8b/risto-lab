---
import Hub from '../../../../../layouts/Instructor.astro';
import {withBase} from '../../../../../lib/urls';
import {safetyLessons,safetySources} from '../../../../data/safety-course';
import type {SafetyLesson} from '../../../../data/safety-course';

export function getStaticPaths(){
 return safetyLessons.map(lesson=>({params:{slug:lesson.slug},props:{lesson}}));
}
const {lesson}=Astro.props as {lesson:SafetyLesson};
const position=safetyLessons.findIndex(item=>item.slug===lesson.slug);
const previous=safetyLessons[position-1];
const next=safetyLessons[position+1];
const root=withBase('/instructor/laboratorio-sicurezza/lezioni/');
const lessonUrl=(slug:string)=>withBase('/instructor/laboratorio-sicurezza/lezioni/'+slug+'/');
---
<Hub title={lesson.title}>
 <header class="lesson-head">
  <p class="eyebrow">RISTO-LAB Instructor · Lezione {String(lesson.number).padStart(2,'0')} di 05</p>
  <nav aria-label="Percorso di sicurezza"><a class="text-link" href={root}>← Tutte le lezioni</a><span class="muted">Studio libero · {lesson.duration} min</span></nav>
  <h1>{lesson.title}</h1>
  <p class="lead">{lesson.intro}</p>
  <div class="lesson-pills"><span>{lesson.tag}</span><span>Riferimento: {lesson.articles}</span></div>
 </header>
 <div class="notice"><strong>Percorso divulgativo non certificante.</strong> Non sostituisce la formazione obbligatoria ai sensi del D.Lgs. 81/2008 e dell’Accordo 59/CSR, né il DVR, le procedure aziendali o una consulenza professionale. Contenuti verificati editorialmente il 29 ottobre 2026; riesaminare la disciplina vigente prima dell’uso applicativo.</div>
 <section class="section">
  <p class="eyebrow">Obiettivi della lezione</p><h2>Alla fine saprai…</h2>
  <ul class="objectives">{lesson.objectives.map(goal=><li>{goal}</li>)}</ul>
 </section>
 <section class="section lesson-text" aria-label="Spiegazione">
  <p class="eyebrow">Leggi e collega</p><h2>Concetti e applicazione</h2>
  {lesson.sections.map((part,i)=><article class="lesson-part">
   <span class="part-no">0{i+1}</span><div><h3>{part.title}</h3>{part.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div>
  </article>)}
 </section>
 <section class="section" id="esercizio">
  <p class="eyebrow">Esercitazione breve · 3–5 minuti</p><h2>{lesson.case.title}</h2>
  <div class="scenario">
   <p class="eyebrow">Situazione inventata</p><p>{lesson.case.situation}</p>
   <h3>Prova a rispondere</h3><p>{lesson.case.prompt}</p>
   <details><summary>Confronta con una possibile risposta ragionata</summary><p>{lesson.case.solution}</p></details>
  </div>
 </section>
 <section class="section">
  <p class="eyebrow">Parole chiave</p><h2>Vocabolario essenziale</h2>
  <dl class="glossary">{lesson.vocab.map(([term,explanation])=><div><dt>{term}</dt><dd>{explanation}</dd></div>)}</dl>
 </section>
 <section class="section" id="quiz">
  <p class="eyebrow">Autovalutazione · 3 domande</p><h2>Hai capito davvero?</h2>
  <p>Seleziona una risposta per ogni domanda. Alla correzione comparirà la spiegazione. Nessun risultato viene inviato o conservato su un server.</p>
  <form id="course-quiz" novalidate>
   {lesson.quiz.map((q,i)=><fieldset class="lesson-q" data-correct={q.correct} data-explanation={q.why}>
    <legend>{i+1}. {q.q}</legend>
    {q.choices.map((choice,j)=><label class="option"><input type="radio" name={'q'+i} value={j}/><span>{choice}</span></label>)}
    <p class="q-feedback" aria-live="polite" role="status"></p>
   </fieldset>)}
   <div class="actions"><button id="grade-lesson" type="button">Verifica le risposte</button><button type="reset" class="secondary">Ricomincia</button></div>
   <p id="lesson-score" role="status" aria-live="polite" class="quiz-score"></p>
  </form>
 </section>
 <section class="section source-section">
  <p class="eyebrow">Documentazione normativa</p><h2>Leggi direttamente la legge e l’Accordo</h2>
  <p>Questi documenti prevalgono sui riassunti didattici quando bisogna accertare una disposizione. Per questioni concrete consultare anche le norme specifiche e gli eventuali chiarimenti aggiornati.</p>
  <ul>
   <li><a href={safetySources.normattiva.url} target="_blank" rel="noopener noreferrer">{safetySources.normattiva.label} ↗</a></li>
   <li><a href={safetySources.accordo.url} target="_blank" rel="noopener noreferrer">{safetySources.accordo.label} ↗</a></li>
   <li><a href={safetySources.gu.url} target="_blank" rel="noopener noreferrer">{safetySources.gu.label} ↗</a></li>
   {lesson.number===3&&<li><a href={safetySources.inail.url} target="_blank" rel="noopener noreferrer">{safetySources.inail.label} ↗</a></li>}
  </ul>
 </section>
 <nav class="lesson-nav" aria-label="Passa a un’altra lezione">
  {previous?<a href={lessonUrl(previous.slug)}>← Lezione {previous.number}: {previous.title}</a>:<a href={root}>← Indice del corso</a>}
  {next?<a href={lessonUrl(next.slug)}>Lezione {next.number}: {next.title} →</a>:<a href={withBase('/instructor/laboratorio-sicurezza/')}>Continua con il laboratorio dinamico →</a>}
 </nav>
</Hub>
<script>
const form=document.querySelector<HTMLFormElement>('#course-quiz');
const result=document.querySelector<HTMLElement>('#lesson-score');
const questions=Array.from(document.querySelectorAll<HTMLFieldSetElement>('.lesson-q'));
document.querySelector('#grade-lesson')?.addEventListener('click',()=>{
 let answered=0,correct=0;
 for(const field of questions){
  const choice=field.querySelector<HTMLInputElement>('input[type="radio"]:checked');
  const feedback=field.querySelector<HTMLElement>('.q-feedback');
  if(!feedback)continue;
  if(!choice){feedback.textContent='Seleziona una risposta per questa domanda.';continue;}
  answered++;
  const yes=Number(choice.value)===Number(field.dataset.correct);
  if(yes)correct++;
  feedback.textContent=(yes?'Corretto. ':'Da rivedere. ')+(field.dataset.explanation||'');
  feedback.dataset.status=yes?'correct':'review';
 }
 if(result)result.textContent='Risposte: '+answered+'/'+questions.length+' · corrette: '+correct+'/'+questions.length+'. Verifica didattica non certificante.';
});
form?.addEventListener('reset',()=>{
 for(const field of questions){const feedback=field.querySelector<HTMLElement>('.q-feedback');if(feedback){feedback.textContent='';delete feedback.dataset.status;}}
 if(result)result.textContent='';
});
</script>
<style>
.lesson-head{max-width:1020px;padding:12px 0 26px}.lesson-head nav{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;margin-bottom:25px}.lesson-head h1{font-size:clamp(2.35rem,5vw,4rem)}.lesson-head .lead{max-width:920px}.lesson-pills{display:flex;flex-wrap:wrap;gap:9px;margin-top:20px}.lesson-pills span{padding:8px 12px;background:var(--soft);border-radius:40px;font-size:.85rem}.objectives{max-width:900px}.objectives li{margin:10px 0;padding-left:8px}.lesson-text{max-width:1080px}.lesson-part{display:grid;grid-template-columns:45px minmax(0,1fr);gap:15px;padding:25px 0;border-top:1px solid var(--line)}.lesson-part h3{font-size:1.5rem;line-height:1.3}.lesson-part p{max-width:90ch;font-size:1rem;line-height:1.78}.part-no{font:500 1.5rem Georgia,serif;color:var(--copper-text)}.scenario{background:var(--soft);border-left:4px solid var(--deep-teal);padding:24px;max-width:950px}.scenario details{margin-top:16px;background:var(--surface);padding:14px 18px;border:1px solid var(--line);border-radius:6px}.scenario summary{cursor:pointer;font-weight:700}.glossary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;max-width:1100px}.glossary>div{padding:21px;border:1px solid var(--line);border-radius:8px}.glossary dt{font-weight:700;margin-bottom:10px;font-size:1.08rem}.glossary dd{margin:0;font-size:.92rem;line-height:1.6}.lesson-q{border:1px solid var(--line);border-radius:8px;margin:0 0 20px;padding:20px;max-width:970px}.lesson-q legend{font-weight:700;line-height:1.5;padding:0 6px}.option{display:flex;flex-direction:row;align-items:flex-start;gap:12px;padding:9px 0;font-size:1rem;font-weight:400;line-height:1.6}.option input{min-height:auto;flex-shrink:0;margin-top:5px}.q-feedback:not(:empty){background:var(--soft);padding:12px 15px;margin-top:12px;border-radius:5px}.q-feedback[data-status="correct"]{border-left:3px solid #3f7656}.q-feedback[data-status="review"]{border-left:3px solid #b17a38}.quiz-score{font-weight:700;margin-top:15px}.source-section li{padding:8px 0;overflow-wrap:anywhere}.lesson-nav{display:flex;align-items:stretch;justify-content:space-between;gap:14px;margin:30px 0 48px}.lesson-nav a{border:1px solid var(--line);padding:16px;border-radius:8px;flex:1;text-decoration:none;font-weight:700}.lesson-nav a:last-child{text-align:right}@media(max-width:760px){.glossary{grid-template-columns:1fr}.lesson-part{grid-template-columns:1fr}.lesson-nav{flex-direction:column}.lesson-nav a:last-child{text-align:left}.scenario{padding:19px}}
</style>