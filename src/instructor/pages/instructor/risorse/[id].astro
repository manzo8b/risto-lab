---
import {withBase} from '../../../../lib/urls';

import {teacherResourceLabel,editorialLabels,publicationLabels,privacyLabels,rightsLabels,classroomUseLabel} from '../../../../lib/presentation';
import {approvedVersion} from '../../../../lib/governance';

import Hub from '../../../../layouts/Instructor.astro';
import SourceText from '../../../../components/SourceText.astro';
import {resources,units,regulations} from '../../../data/catalog';
import {isAvailable,isClassroomApproved,assetUrl} from '../../../../lib/resources';
export function getStaticPaths(){return resources.filter(isAvailable).map(r=>({params:{id:r.id}}));}
const r=resources.find(x=>x.id===Astro.params.id);if(!r||!isAvailable(r))return new Response('Materiale non disponibile',{status:404});
const unit=units.find(u=>r.unit_ids.includes(u.id));
---
<Hub title={r.title}><p class="eyebrow">{unit?<a href={withBase('/instructor/unita/')+unit.slug+'/'}>Unità {String(unit.order).padStart(2,'0')} · {unit.title}</a>:<a href={withBase("/instructor/raccolte/")}>Materiale trasversale</a>} / {teacherResourceLabel(r)}</p><h1>{r.title}</h1><p class="muted prose">{r.description}</p>{r.review_note&&<div class="notice"><strong>Contenuto da revisionare</strong><p>{r.review_note}</p></div>}<div class="notice"><strong>{approvedVersion(r)?'Versione approvata per Aula':'NESSUNA VERSIONE APPROVATA'}</strong><p>{approvedVersion(r)?.label||'Anteprima di consultazione docente. Il file aperto non è una selezione approvata per l’aula.'}</p></div>{r.regulatory_status!=='NOT_APPLICABLE'&&r.regulatory_status!=='VERIFIED_CURRENT'&&<p class="notice">Vigenza normativa non verificata.</p>}<p class="eyebrow">{r.entity_type==='TEACHING_RESOURCE'?'FONTE DIDATTICA':'COPIA DI FONTE NORMATIVA'}</p><div class="actions">{unit&&r.visibility!=='TEACHER'&&isClassroomApproved(r)&&<a class="button" href={withBase(`/instructor/aula/?unit=${unit?.id}&resource=${r.id}`)}>Apri in Aula ↗</a><a class="button secondary" href={withBase('/instructor/sessioni/nuova/?unit=')+unit.id+'&resource='+r.id}>Crea lezione</a>}{r.asset_filename&&<a class="button secondary" href={assetUrl(r.id)} target="_blank" rel="noopener">Apri file ↗</a>}{r.downloadable&&<a class="button secondary" href={assetUrl(r.id)+'?download=1'}>{r.asset_mime==='application/pdf'?'Scarica PDF':'Scarica file'}</a>}{(r.type==='IMAGE'||r.asset_mime==='application/pdf')&&<button id="viewer-fullscreen" class="secondary">Schermo intero</button>}</div><details class="ai-resource-menu"><summary>✦ Chiedi a RISTO-LAB AI</summary><div class="actions">{[['explain','Spiegami questo'],['activity','Crea un’attività'],['quiz','Crea domande']].map(([task,label])=><a class="button secondary" href={withBase('/instructor/ai/?resource=')+r.id+'&task='+task}>{label}</a>)}</div></details><section class="viewer" id="viewer">{r.type==='IMAGE'?<figure><img src={assetUrl(r.id)} alt={r.alt} width={r.width} height={r.height} loading="eager"/><figcaption>{r.collection_id?'Supporto visuale di consultazione docente. Consulta la nota di revisione prima dell’uso in aula.':'Riferimento visuale: applicare lo standard del locale e il menu previsto. Le indicazioni della fonte non sono una norma universale.'}</figcaption></figure>:r.asset_mime==='application/pdf'?<><iframe src={assetUrl(r.id)} title={r.title} loading="lazy"></iframe><p class="muted">Se il PDF non viene visualizzato, usa «Apri file» o «Scarica file».</p></>:r.asset_filename?<div class="card prose"><h2>File {r.format}</h2><p>Scarica il documento e aprilo con un’applicazione compatibile. La visualizzazione incorporata è disponibile per PDF e immagini.</p></div>:r.type==='QUIZ'?<><p>{r.questions?.length||1} domande. Le soluzioni si consultano nella console docente.</p><a class="button" href={withBase('/instructor/aula/?unit=')+unit?.id+'&resource='+r.id}>Avvia il quiz</a></>:<article class="prose"><SourceText text={r.reading||r.body||''}/></article>}</section>{r.files&&r.files.length>1&&<section class="section"><h2>Formati e versioni correlate</h2><div class="grid">{r.files.map(f=><article class="card file-version"><h3>{f.label}</h3><p class="muted">{f.label}</p><a class="button secondary" href={withBase('/materiali/'+encodeURIComponent(f.asset_filename))}>Scarica questa versione</a></article>)}</div></section>}{!!r.regulation_ids?.length&&<section class="section"><h2>FONTI NORMATIVE COLLEGATE</h2><div class="actions">{r.regulation_ids.map(id=><a class="button secondary" href={withBase('/instructor/normativa/#')+id}>{regulations.find(x=>x.id===id)?.title}</a>)}</div></section>}{!!r.related_resource_ids?.length&&<section class="section"><h2>Materiali collegati</h2><div class="actions">{r.related_resource_ids.map(id=><a class="button secondary" href={withBase('/instructor/risorse/')+id+'/'}>{resources.find(x=>x.id===id)?.title}</a>)}</div></section>}<section class="section"><h2>Stato del materiale</h2><dl class="governance-grid"><div><dt>Stato editoriale</dt><dd>{editorialLabels[r.canonical_status]}</dd></div><div><dt>Uso in aula</dt><dd>{classroomUseLabel(r)}</dd></div><div><dt>Pubblicazione</dt><dd>{publicationLabels[r.publication_status]}</dd></div><div><dt>Diritti</dt><dd>{r.private_use_authorized?'Uso privato autorizzato · ':''}{rightsLabels[r.rights_status]}</dd></div><div><dt>Privacy</dt><dd>{privacyLabels[r.privacy_status]}</dd></div></dl></section><script>const rid=location.pathname.split('/').filter(Boolean).pop();try{const recent=JSON.parse(localStorage.getItem('risto-recent-resources')||'[]');if(rid)localStorage.setItem('risto-recent-resources',JSON.stringify([rid,...(Array.isArray(recent)?recent:[]).filter((id:string)=>id!==rid)].slice(0,5)));}catch{}document.querySelector('#viewer-fullscreen')?.addEventListener('click',async()=>{try{await document.querySelector('#viewer')?.requestFullscreen();}catch{window.open(document.querySelector<HTMLIFrameElement>('iframe')?.src||document.querySelector<HTMLImageElement>('.viewer img')?.src,'_blank','noopener');}});</script></Hub>

<style>.file-version{min-width:0;overflow-wrap:anywhere}.technical{overflow-wrap:anywhere}</style>

<style>.governance-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.governance-grid dt{font-size:.8rem;color:var(--muted);margin-bottom:8px}.governance-grid dd{margin:0;overflow-wrap:anywhere}@media(max-width:600px){.governance-grid{grid-template-columns:1fr}}</style>
