---
import {withBase} from '../../../lib/urls';

import Hub from '../../../layouts/Instructor.astro';
import Library from '../../../components/Library.astro';
import {resources,units} from '../../data/catalog';
const food=resources.filter(r=>r.collection_id==='haccp-rintracciabilita');
---
<Hub title="Sicurezza Alimentare"><p class="eyebrow">Instructor Hub · Raccolta tematica</p><h1>Sicurezza Alimentare</h1><p class="lead muted">Dalle fonti alla pratica: igiene e HACCP, pericoli e contaminazioni, rintracciabilità, allergeni e criteri microbiologici.</p><div class="stats"><span><strong>{food.length}</strong> materiali organizzati</span><span>Unità di riferimento: 16, 17 e 18</span><span>Versioni locali da revisionare</span></div><div class="notice">Le dispense spiegano e accompagnano le lezioni; i testi normativi e le linee guida conservano data ed edizione. Copie storiche e consolidamenti non attestano la vigenza. I materiali restano di consultazione docente.</div><div class="actions"><a class="button secondary" href={withBase("/instructor/normativa/")}>Indice normativo e fonti ufficiali ↗</a>{units.filter(u=>[16,17,18].includes(u.order)).map(u=><a class="text-link" href={withBase('/instructor/unita/')+u.slug+'/'}>Unità {u.order} · {u.title} ↗</a>)}</div><section class="section"><h2>Documenti e strumenti</h2><p class="muted">Apri una scheda per leggere il PDF, confrontare le versioni e trovare i materiali collegati.</p><Library resources={food} units={units}/></section></Hub>
