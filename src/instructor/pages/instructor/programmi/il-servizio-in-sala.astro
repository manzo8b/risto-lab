---
import {withBase} from '../../../../lib/urls';

import Hub from '../../../../layouts/Instructor.astro';import {program,units,labels,resources,classroomSequence,regulations} from '../../../data/catalog';import {isClassroomApproved} from '../../../../lib/resources';
const groups=(id:string)=>{const rs=resources.filter(r=>r.unit_ids.includes(id));return [['Contenuti',rs.filter(r=>['TEXT','CHECKLIST'].includes(r.type))],['Materiali Aula',rs.filter(r=>isClassroomApproved(r)&&r.visibility!=='TEACHER')],['Esercizi',rs.filter(r=>r.type==='EXERCISE')],['Quiz',rs.filter(r=>r.type==='QUIZ')],['Dispense e stampabili',rs.filter(r=>['PDF','HANDOUT','DOCUMENT'].includes(r.type)||r.downloadable)],['Media',rs.filter(r=>['IMAGE','VIDEO','AUDIO'].includes(r.type))]] as const;};
---
<Hub title={program.title}><p class="eyebrow">Il curriculum</p><h1>{program.title}</h1><p class="prose muted">{program.description}</p><p>26 unità. Apri una riga per esplorare i materiali oppure entra nell’unità per preparare la spiegazione.</p><p class="prose muted"><strong>Fondamenti · Unità 01–06</strong><br/>Ristorazione, professione, squadra, spazi e materiali preparano al lavoro sulla mise en place.</p><p class="prose muted"><strong>Ciclo del servizio · Unità 07–15</strong><br/>Postazione → menu → stili → accoglienza → comunicazione → comanda → servizio → sbarazzo → chiusura.</p><p><a class="text-link" href={withBase('/materiali/il-ciclo-del-servizio-sessione.json')} download>Scarica lezione «Il ciclo del servizio» · 60 min</a><br/><span class="muted">In Crea lezione, usa Importa JSON per modificare il modello. I materiali restano quelli delle singole unità.</span></p><div class="unitlist">{units.map(u=>{const aula=resources.filter(r=>r.unit_ids.includes(u.id)).filter(r=>isClassroomApproved(r)&&r.visibility!=='TEACHER'),related=regulations.filter(r=>r.unit_ids.includes(u.id));return <article class="curriculum-unit" data-unit={u.id}><div class="curriculum-row"><a class="unitrow" href={withBase('/instructor/unita/')+u.slug+'/'}><span class="unitnumber">{String(u.order).padStart(2,'0')}</span><div><h3>{u.title}</h3><p class="muted">{aula.length} risorse Aula</p></div><span class:list={['pill',u.status==='PARTIAL'?'badge-partial':'']}>{labels[u.status]} ↗</span></a></div><details class="curriculum-expand"><summary>Esplora materiali · Unità {String(u.order).padStart(2,'0')}</summary><div class="curriculum-content">{aula.length>0&&<div class="actions"><a class="button" href={withBase('/instructor/aula/?unit=')+u.id}>Avvia in Aula ↗</a><a class="button secondary" href={withBase('/instructor/sessioni/nuova/?unit=')+u.id}>Crea lezione</a><a class="button secondary" href={withBase('/instructor/unita/')+u.slug+'/#docente'}>Materiali</a></div>}{aula.length===0&&<a class="button secondary" href={withBase('/instructor/unita/')+u.slug+'/#docente'}>Materiali</a>}{groups(u.id).filter(([,items])=>items.length).map(([title,items])=><details class="curriculum-category"><summary>{title} · {items.length}</summary><ul>{items.map(r=><li><a href={withBase('/instructor/risorse/')+r.id+'/'}>{r.title}</a>{isClassroomApproved(r)&&r.visibility!=='TEACHER'&&<span class="pill">Aula</span>}</li>)}</ul></details>)}{related.length>0&&<details class="curriculum-category"><summary>Fonti normative · {related.length}</summary><ul>{related.map(r=><li><a href={withBase('/instructor/normativa/#')+r.id}>{r.title}</a> · Vigenza da verificare</li>)}</ul></details>}{aula.length>0&&<details class="curriculum-category"><summary>Sequenza Aula approvata</summary><ol>{classroomSequence.map(p=>aula.find(r=>r.id===p.resource_id)).filter(Boolean).map(r=><li>{r!.title}</li>)}</ol><p class="muted">Per cambiare ordine o durata, crea una lezione.</p></details>}</div></details></article>})}</div></Hub>
