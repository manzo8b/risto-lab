---
import {withBase} from '../../../lib/urls';
import Hub from '../../../layouts/Instructor.astro';
import Library from '../../../components/Library.astro';
import {resources,units} from '../../data/catalog';
---
<Hub title="Cerca il materiale giusto."><p class="eyebrow">Strumenti docente</p><h1>Cerca il materiale giusto</h1><p class="muted">Titolo, descrizione, argomento, tipo e unità. Ricerca locale, senza servizi esterni.</p><Library resources={resources} units={units}/><p class="section">Non trovi quello che cerchi? <a id="search-ai" class="text-link" href={withBase('/instructor/ai/?task=research')}>✦ Chiedi a RISTO-LAB</a></p><script>import {withBase} from '../../../lib/urls';const q=document.querySelector<HTMLInputElement>('#query')!;const a=document.querySelector<HTMLAnchorElement>('#search-ai')!;const update=()=>{a.href=withBase('/instructor/ai/?task=research&q=')+encodeURIComponent(q.value);document.querySelectorAll<HTMLAnchorElement>('[data-ai-entry]').forEach(link=>link.href=a.href);};q.addEventListener('input',update);update();</script></Hub>