---
import {withBase} from '../../../../lib/urls';

import Icon from '../../../../components/Icon.astro';
import Hub from '../../../../layouts/Instructor.astro';
import Card from '../../../../components/ResourceCard.astro';
import SourceText from '../../../../components/SourceText.astro';
import CrossCurriculumHub from '../../../../components/CrossCurriculumHub.astro';
import pathRegistry from '../../../data/cross-curriculum.json';
import {units,resources,labels,regulations,classroomResourceIds} from '../../../data/catalog';
import {isAvailable,isClassroomApproved,assetUrl} from '../../../../lib/resources';
export function getStaticPaths(){return units.map(u=>({params:{slug:u.slug}}));}
const u=units.find(u=>u.slug===Astro.params.slug);if(!u)return new Response('Unità non trovata',{status:404});
const rs=resources.filter(r=>u.resource_ids.includes(r.id));const ready=rs.filter(isAvailable);const core=ready.find(r=>r.id==='res-mep-text');const visuals=ready.filter(r=>r.type==='IMAGE'&&r.visibility!=='TEACHER'&&([6,10,17].includes(u.order)||isClassroomApproved(r)));const tasks=ready.filter(r=>r.type==='EXERCISE'&&(![24,25].includes(u.order)||r.unit_ids.includes(u.id)));const quiz=ready.find(r=>r.type==='QUIZ');const checklist=ready.find(r=>r.type==='CHECKLIST'&&r.unit_ids.includes(u.id))||ready.find(r=>r.type==='CHECKLIST');const pdf=ready.find(r=>r.id===u.printable_resource_id||r.id==='res-mep-pdf'||r.id===`res-u${u.order}-print`);const errors=ready.find(r=>r.id==='res-mep-errors');
const pilot=u.order!==6;const pilotTexts=pilot?ready.filter(r=>r.type==='TEXT'&&isClassroomApproved(r)):[];
const ordered=classroomResourceIds(u.id).map(id=>ready.find(r=>r.id===id&&isClassroomApproved(r)&&r.visibility!=='TEACHER')).filter(Boolean);
const chapter=ready.find(r=>r.id===u.chapter_resource_id);const related=regulations.filter(r=>r.unit_ids.includes(u.id));const hasClassroom=rs.some(isClassroomApproved);
---
<Hub title={u.title}><header class="unit-heading"><span class="unit-number-large" aria-hidden="true">{String(u.order).padStart(2,'0')}</span><div><h1>{u.title}</h1><p class="lead muted">{u.overview||'Il capitolo del manuale è disponibile. Le altre risorse saranno aggiunte progressivamente.'}</p></div><span class="pill badge-partial">{labels[u.status]}</span></header><p class="unit-ai-link"><a class="text-link" href={withBase('/instructor/ai/?unit=')+u.id}>✦ Chiedi a RISTO-LAB</a></p>{[16,18].includes(u.order)&&<aside class="notice" id="hygiene-source-boundary"><strong>Fonte didattica e procedure del locale</strong><p>I contenuti selezionati vengono dal manuale RISTO-LAB. Le buone pratiche sono indicazioni formative; metodi, prodotti, frequenze e responsabilità operative seguono la procedura del locale. I requisiti normativi si consultano nel testo ufficiale.</p><a href="https://eur-lex.europa.eu/legal-content/IT/TXT/?uri=CELEX:02004R0852-20210324" target="_blank" rel="noopener">Reg. 852/2004 · Allegato II, capitoli VIII e XI bis ↗</a><p class="muted">Riferimenti puntuali controllati il 23 ottobre 2026; non è una verifica del piano aziendale o dell’intero quadro normativo.</p></aside>}{u.order===18&&<aside class="notice" id="editorial-boundary"><strong>Come leggere questa unità</strong><ul><li>Contenuto dalla fonte: principi e casi del capitolo 18.</li><li>Analisi editoriale: interpretazione didattica del rapporto tra documenti e pratica.</li><li>Osservazione operativa: elementi da osservare nel caso simulato, senza generalizzarli a tutte le imprese.</li><li>Requisito normativo: testo ufficiale separato dall’analisi; nessun caso equivale a un giudizio di conformità.</li></ul><p>Materiale parziale: la discussione va validata con il docente prima di applicarla a una procedura reale.</p></aside>}{u.order===26&&<aside class="notice" id="assessment-scope"><strong>Verifica finale RISTO-LAB</strong><p>{pathRegistry.notice}</p><p>Nessuna soglia automatica di promozione. Conoscenze, prova pratica, osservazione e riflessione compongono il profilo finale; le schede compilate restano fuori dal sito.</p><a class="text-link" href={withBase('/materiali/verifica-finale-sessione.json')} download>Scarica il modello di verifica · 120 min</a></aside>}{u.order===17&&<p class="notice"><strong>FONTE DIDATTICA</strong> · Introduzione per sala e bar, non un piano di autocontrollo aziendale. Le fonti normative sono collegate separatamente; vigenza normativa non verificata.</p>}{hasClassroom?<><div class="unit-actionbar"><div><strong>Per la tua sessione</strong><p class="muted">Testo, visuali, pratica e verifica per la sessione guidata</p></div><a class="button" href={withBase('/instructor/aula/?unit=')+u.id}><Icon name="play"/>Avvia in Aula</a><a class="button secondary" href={withBase('/instructor/sessioni/nuova/?unit=')+u.id}>Crea lezione</a>{pdf&&<a class="button secondary" href={withBase('/instructor/risorse/')+pdf.id+'/'}>{pdf.type==='CHECKLIST'?'Checklist stampabile ↗':'Scheda attività stampabile ↗'}</a>}</div><nav class="section-nav" aria-label="Sezioni dell’unità"><a href="#obiettivi">Obiettivi</a><a href="#contenuti">Contenuti</a>{visuals.length>0&&<a href="#visuali">Visuali</a>}{(tasks.length>0||[24,25].includes(u.order))&&<a href="#pratica">Pratica</a>}{quiz&&<a href="#verifica">Verifica</a>}<a href="#docente">Materiali docente</a></nav></>:<p class="notice">Le risorse per Aula, esercizi e verifiche saranno aggiunte progressivamente al capitolo.</p>}{[24,25].includes(u.order)&&<CrossCurriculumHub kind={u.order===24?'scenario':'lab'}/>}{chapter&&<section class="card section" id="capitolo"><p class="eyebrow">Il Servizio in Sala · Manuale mf.v.04</p><h2>Il capitolo dell’unità</h2><p class="prose muted">{chapter.description}</p><div class="actions"><a class="button" href={withBase('/instructor/risorse/')+chapter.id+'/'}>Leggi il capitolo PDF ↗</a><a class="button secondary" href={assetUrl(chapter.id)+'?download=1'}>Scarica capitolo</a></div></section>}{hasClassroom&&<details class="unit-sequence"><summary>Sequenza Aula · {ordered.length} materiali</summary><ol>{ordered.map(r=><li><a href={withBase('/instructor/aula/?unit=')+u.id+'&resource='+r!.id}>{r!.title}</a></li>)}</ol></details>}{u.objectives&&<section id="obiettivi" class="section"><p class="eyebrow">Prima di cominciare</p><h2>Obiettivo dell’unità</h2><div class="prose"><ul class="objectives">{u.objectives.map(o=><li>{o}</li>)}</ul></div></section>}{pilotTexts.length>0&&<section class="section" id="contenuti"><p class="eyebrow">Fonte didattica · concetti e casi</p><h2>Il percorso didattico</h2>{pilotTexts.map(r=><article class="pilot-reading"><h3>{r.title}</h3>{u.order===18&&<p class="eyebrow">{r.content_classification==='EDITORIAL_ANALYSIS'?'Analisi editoriale':'Osservazione operativa'}</p>}<SourceText text={r.reading||r.body||''}/><a class="text-link" href={withBase('/instructor/aula/?unit=')+u.id+'&resource='+r.id}>Apri in Aula ↗</a></article>)}</section>}{core&&<section class="section unit-reading" id="contenuti"><div><p class="eyebrow">Comprendere</p><h2>Preparare il servizio,<br/>non soltanto il tavolo</h2><p class="muted">Testo di riferimento per la spiegazione. In Aula viene presentato in brevi passaggi.</p><a class="text-link" href={withBase('/instructor/risorse/')+core.id+'/'}>Apri il testo docente ↗</a></div><div class="editorial-note"><SourceText text={core.body||''}/></div></section>}{visuals.length>0&&<section class="section" id="visuali"><p class="eyebrow">Osservare e confrontare</p><h2>Il materiale visuale</h2><div class="visual-grid">{visuals.map(r=><figure class="visual-card"><a href={withBase('/instructor/risorse/')+r.id+'/'}><img src={assetUrl(r.id)} alt={r.alt} width={r.width} height={r.height} loading="lazy"/></a><figcaption><h3>{r.title}</h3><p class="muted">Da leggere insieme al menu e allo standard del locale.</p><a class="text-link" href={withBase('/instructor/risorse/')+r.id+'/'}>Apri e ingrandisci ↗</a></figcaption></figure>)}</div></section>}{tasks.length>0&&<section class="section" id="pratica"><p class="eyebrow">Mettere in pratica</p><h2>{pilot?'Mettere alla prova le scelte':'Dal concetto alla tavola'}</h2>{tasks.map(r=><div class="practice-card"><div><span class="pill">Esercizio</span><h3>{r.title}</h3>{u.order>=7&&![10,17].includes(u.order)&&<p class="muted">{r.description}</p>}<SourceText text={r.body||''}/></div><a class="button secondary" href={withBase('/instructor/aula/?unit=')+u.id+'&resource='+r.id}>Mostra l’esercizio ↗</a></div>)}</section>}{quiz&&<section class="section" id="verifica"><div class="section-heading"><div><p class="eyebrow">Rivedere insieme</p><h2>Una verifica guidata</h2><p class="muted">{quiz.questions?.length} domande · risposte sotto il controllo del docente</p></div><a class="button" href={withBase('/instructor/aula/?unit=')+u.id+'&resource='+quiz.id}>Avvia il quiz ↗</a></div></section>}{checklist&&<section class="section"><p class="eyebrow">Prima del servizio</p><h2>{pilot?'Osserva, ripeti, confronta':'Un controllo, sempre nello stesso ordine'}</h2><div class="checklist-grid">{checklist.sections?.map(s=><article class="card"><h3>{s.title}</h3><ul>{s.items.map(t=><li>{t}</li>)}</ul></article>)}</div>{pdf&&<div class="actions"><a class="button secondary" href={withBase('/instructor/risorse/')+pdf.id+'/'}>{pdf.type==='CHECKLIST'?'Apri la checklist PDF ↗':'Apri la scheda attività PDF ↗'}</a><a class="text-link" href={assetUrl(pdf.id)+'?download=1'}>Scarica per la stampa</a></div>}</section>}{errors&&<section class="section"><h2>Riconoscere gli errori</h2><p class="prose muted">Il controllo non finisce sul piano del tavolo. Il testo di riferimento aiuta a rivedere ordine, pulizia e coerenza.</p><a class="text-link" href={withBase('/instructor/risorse/')+errors.id+'/'}>Apri il testo sugli errori frequenti ↗</a></section>}{u.order>=23&&<section class="section" id="strumenti-percorso"><h2>Strumenti per condurre l’incontro</h2><div class="actions">{pathRegistry.templates.filter(t=>u.order===23?t.filename.startsWith('preparazione-'):u.order===24?t.filename.startsWith('simulazione-')||t.filename.startsWith('servizio-completo-'):u.order===25?t.filename.startsWith('laboratorio-'):t.filename.startsWith('verifica-')).map(t=><a class="button secondary" href={withBase('/materiali/')+t.filename} download>{t.title} · {t.minutes} min ↗</a>)}</div><p class="muted">Apri Crea lezione e usa Importa JSON. Controlla data, materiali, tempi e numero di giri prima di avviare.</p><div class="grid">{ready.filter(r=>r.unit_ids.includes(u.id)&&r.downloadable&&r.id.startsWith(`res-u${u.order}-`)).map(resource=><Card resource={resource}/>)}</div></section>}<section class="section" id="docente"><div class="section-heading"><div><p class="eyebrow">Preparazione docente</p><h2>Fonti e materiali</h2></div><a href={withBase("/instructor/biblioteca/")}>Vai alla biblioteca ↗</a></div><div class="grid">{rs.filter(r=>!isAvailable(r)||['PDF','HANDOUT','REGULATORY_COPY'].includes(r.type)||r.collection_id).map(resource=><Card resource={resource}/>)}</div><details class="technical"><summary>Stato di preparazione</summary><p>Unità di curriculum, non una lezione web automatica. Fonte: manuale mf.v.04, capitolo {u.order}, pagina {u.manual_page}. I materiali pubblicati sono autorizzati dal proprietario. La selezione per Aula è distinta dalla pubblicazione. La completezza editoriale resta da validare in aula.</p><p>Il catalogo raccoglie anche materiali consultabili dal docente. La sequenza Aula segue soltanto l’ordine dei materiali approvati; con Crea lezione puoi scegliere ordine e tempi del tuo incontro.</p></details></section>{related.length>0&&<section class="section" id="normativa"><p class="eyebrow">Riferimenti del capitolo</p><h2>Normativa e fonti ufficiali</h2>{related.length>0?<div class="grid">{related.map(r=><article class="card"><span class="pill">{r.category}</span><h3>{r.title}</h3><p class="muted">{r.topic} · Vigenza da verificare</p><a class="text-link" href={withBase('/instructor/normativa/#')+r.id}>Apri la scheda e i riferimenti ↗</a></article>)}</div>:<p class="muted">Nessun riferimento normativo esplicito indicizzato in questo capitolo. La raccolta verrà integrata progressivamente.</p>}</section>}<section class="section"><h2>Continua nel curriculum</h2><div class="actions">{units.filter(x=>Math.abs(x.order-u.order)===1).map(x=><a class="button secondary" href={withBase('/instructor/unita/')+x.slug+'/'}>{String(x.order).padStart(2,'0')} · {x.title}</a>)}</div></section></Hub>
