---
import {withBase} from '../../../lib/urls';

import Hub from '../../../layouts/Instructor.astro';
import {collections,resources} from '../../data/catalog';
---
<Hub title="Raccolte"><p class="eyebrow">Materiali complementari</p><h1>Le tue raccolte</h1><p class="lead muted">Raccolte tematiche per ritrovare documenti, verifiche e supporti visuali. Il corso principale resta Il Servizio in Sala, con le sue 26 unità.</p><div class="notice">Materiali di consultazione docente. Le versioni modificabili sono raccolte nella stessa scheda del documento; quiz e guide possono contenere soluzioni. La revisione didattica e normativa resta da completare.</div>{collections.map(c=>{const rs=resources.filter(r=>r.collection_id===c.id);const kinds=[...new Set(rs.map(r=>r.material_kind))];return <section class="section" id={c.id}><p class="eyebrow">{rs.length} materiali</p><h2>{c.title}</h2>{c.id==='haccp-rintracciabilita'&&<p><a class="text-link" href={withBase("/instructor/sicurezza-alimentare/")}>Apri la sezione Sicurezza Alimentare ↗</a></p>}<p class="prose muted">{c.description}</p><div class="actions">{kinds.map(k=><span class="pill">{k} · {rs.filter(r=>r.material_kind===k).length}</span>)}</div><div class="grid">{rs.map(r=><article class="card"><p class="eyebrow">{r.material_kind} · {r.format}</p><h3>{r.title}</h3><p class="muted">{r.description}</p><p class="pill badge-review">Contenuto da revisionare</p><p class="muted">{r.unit_ids.length?'Collegato alle unità '+r.unit_ids.map(id=>id.replace('unit-','')).join(', '):'Materiale trasversale'}</p><a class="text-link" href={withBase('/instructor/risorse/')+r.id+'/'}>Apri materiale ↗</a></article>)}</div><div class="actions"><a class="button secondary" href={withBase('/instructor/biblioteca/?collection=')+c.id}>Filtra questa raccolta in biblioteca ↗</a></div></section>})}</Hub>
