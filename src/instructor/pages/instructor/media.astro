---
import Hub from '../../../layouts/Instructor.astro';
import Card from '../../../components/ResourceCard.astro';
import VideoCard from '../../../components/VideoCard.astro';
import {resources} from '../../data/catalog';
---
<Hub title="Media"><p class="eyebrow">Fonti visuali</p><h1>Media e documenti</h1><p class="muted">Immagini selezionate e documenti per l’aula. I video restano riferimenti da revisionare.</p><div class="grid">{resources.filter(r=>['IMAGE','PDF','SLIDES','HANDOUT','REGULATORY_COPY'].includes(r.type)).map(resource=><Card resource={resource}/>)}</div><section class="section"><h2>Riferimenti video</h2><div class="grid">{resources.filter(r=>r.type==='VIDEO').map(resource=><VideoCard resource={resource}/>)}</div></section></Hub>
