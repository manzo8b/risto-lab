---
import {withBase} from '../../../lib/urls';

import {assetUrl} from '../../../lib/resources';
import Hub from '../../../layouts/Instructor.astro';
import {regulations,units,resources} from '../../data/catalog';
const categories=['Unione Europea','Italia','Regione Lazio','Manuali / Linee guida'];
---
<Hub title="Normativa"><p class="eyebrow">Fonti e riferimenti</p><h1>La normativa,<br/>con il suo contesto</h1><p class="lead muted">Un indice dei riferimenti citati nei capitoli e delle copie locali disponibili. Ogni documento conserva la sua versione e provenienza.</p><div class="notice">Il collegamento a una fonte ufficiale non certifica la vigenza. Tutti i riferimenti hanno stato «Vigenza normativa non verificata.». I testi mancanti saranno collegati o caricati progressivamente.</div><div class="actions"><label>Cerca un riferimento <input id="reg-search" type="search" placeholder="Numero, titolo o argomento"/></label><label>Categoria <select id="reg-category" aria-label="Categoria"><option value="">Tutte le categorie</option>{categories.map(c=><option value={c}>{c}</option>)}</select></label><label>Collegamento <select id="reg-link" aria-label="Collegamento"><option value="">Tutti</option><option value="OFFICIAL_LINK_FOUND">Fonte ufficiale disponibile</option><option value="MISSING">Da completare</option></select></label></div><p id="reg-count" class="muted" aria-live="polite">{regulations.length} riferimenti indicizzati</p>{categories.map(category=><section class="section regulation-group" data-category={category}><p class="eyebrow">{category}</p><h2>{category}</h2>{regulations.filter(r=>r.category===category).length===0&&<p class="muted">Consulta le linee guida nella sezione Sicurezza Alimentare; identificazione delle fonti da completare.</p>}<div class="grid">{regulations.filter(r=>r.category===category).map(r=><article class="card regulation" id={r.id} data-category={r.category} data-link={r.link_status} data-search={[r.title,r.topic,r.authority,...r.unit_ids.map(id=>units.find(u=>u.id===id)?.title)].join(' ').toLocaleLowerCase('it')}><span class="pill">{r.topic}</span><h3>{r.title}</h3><p class="muted">{r.authority} · {r.source_kind}</p><p><span class="pill badge-review">Vigenza normativa non verificata.</span></p>{r.source_url?<p><a class="text-link" href={r.source_url} target="_blank" rel="noopener noreferrer">{r.category==='Regione Lazio'?'Apri scheda ufficiale e allegati':'Apri il testo ufficiale'} ↗</a><br/><small class="muted">Collegamento individuato il {r.link_checked_at}</small></p>:<p class="notice">Collegamento al testo ufficiale da completare. Le eventuali copie locali sono indicate nella scheda.</p>}<p class="muted">{r.note}</p>{!!r.teaching_resource_ids.length&&<details><summary>Fonti didattiche collegate ({r.teaching_resource_ids.length})</summary><ul>{r.teaching_resource_ids.map(id=><li><a href={withBase('/instructor/risorse/')+id+'/'}>{resources.find(x=>x.id===id)?.title}</a></li>)}</ul></details>}{!!r.resource_ids?.length&&<div><h4>Documenti locali e versioni</h4>{r.resource_ids.map(id=><p><a class="text-link" href={withBase('/instructor/risorse/')+id+'/'}>{resources.find(x=>x.id===id)?.title} ↗</a></p>)}<small class="muted">Copie storiche di consultazione: la disponibilità del PDF non attesta l’aggiornamento.</small></div>}<details><summary>Citazioni nei capitoli ({r.citations.length})</summary><ul>{r.citations.map(c=>{const u=units.find(x=>x.id===c.unit_id)!;return <li><a href={withBase('/instructor/unita/')+u.slug+'/'}>Unità {String(u.order).padStart(2,'0')} · {u.title}</a> — <a href={assetUrl(c.resource_id)+'#page='+c.pdf_page}>pagina {c.pdf_page} del capitolo PDF</a></li>})}</ul></details></article>)}</div></section>)}<p><a class="button secondary" href={withBase("/instructor/laboratorio-sicurezza/")}>Laboratorio interattivo sicurezza e Accordo 2025 ↗</a></p><p><a class="button secondary" href={withBase("/instructor/sicurezza-alimentare/")}>Dispense e linee guida di Sicurezza Alimentare ↗</a></p><p id="reg-empty" class="notice" hidden>Nessun riferimento corrisponde ai filtri.</p></Hub>
<script>
const search=document.querySelector<HTMLInputElement>('#reg-search')!;const category=document.querySelector<HTMLSelectElement>('#reg-category')!;const link=document.querySelector<HTMLSelectElement>('#reg-link')!;
function filter(){let count=0;document.querySelectorAll<HTMLElement>('.regulation').forEach(el=>{const visible=(!category.value||el.dataset.category===category.value)&&(!link.value||el.dataset.link===link.value)&&(!search.value||el.dataset.search?.includes(search.value.toLocaleLowerCase('it').trim()));el.hidden=!visible;if(visible)count++;});document.querySelectorAll<HTMLElement>('.regulation-group').forEach(el=>{el.hidden=!!category.value&&el.dataset.category!==category.value;});document.querySelector('#reg-count')!.textContent=count+' riferimenti visibili';(document.querySelector('#reg-empty') as HTMLElement).hidden=count!==0;}[search,category,link].forEach(el=>el.addEventListener('input',filter));
</script>
<style>.regulation{scroll-margin-top:2rem}.regulation[hidden],.regulation-group[hidden]{display:none}input,select{display:block;width:100%;max-width:24rem;padding:.7rem;border:1px solid var(--line,#ddd);border-radius:.5rem;background:var(--paper,#fff);color:inherit}.regulation li{margin-block:.7rem;overflow-wrap:anywhere}</style>
