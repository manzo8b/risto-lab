---import {withBase} from '../lib/urls';

import '../styles/global.css';
import '../styles/instructor.css';
import Icon from '../components/Icon.astro';
import type {IconName} from '../lib/icons';
const {title='Instructor Hub'}=Astro.props;
const nav:[string,string,IconName][]=[[withBase('/instructor/'),'Home','home'],[withBase('/instructor/programmi/'),'Programma','book'],[withBase('/instructor/sessioni/'),'Lezioni','layers'],[withBase('/instructor/biblioteca/'),'Biblioteca','file'],[withBase('/instructor/cerca/'),'Cerca','search'],[withBase('/instructor/aula/'),'Aula','screen']];
const extra:[string,string,IconName][]=[[withBase('/instructor/normativa/'),'Normativa','book'],[withBase('/instructor/raccolte/'),'Raccolte','layers'],[withBase('/instructor/sicurezza-alimentare/'),'Sicurezza Alimentare','book'],[withBase('/instructor/media/'),'Media','image']];
---
<!doctype html><html lang="it"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="RISTO-LAB: materiali, curriculum e strumenti per insegnare il servizio in sala."/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site).href}/><link rel="icon" href={withBase("/favicon.svg")}/><title>{String(title).replace(/\.$/,'')} · RISTO-LAB Docente</title></head><body class="instructor-shell"><a class="skip" href="#contenuto">Vai al contenuto</a><header class="topbar"><div class="wrap toprow"><a class="brand" href={withBase("/instructor/")}>RISTO<i>—</i>LAB<small>Instructor Hub</small></a><div class="nav"><a href={withBase("/instructor/")}><Icon name="home"/> Home</a><a href={withBase("/instructor/cerca/")}>Cerca materiale</a><span class="devbadge">Materiali pubblici</span></div></div></header><div class="hubbody"><aside class="sidebar"><p class="eyebrow">Instructor Hub</p><nav class="nav" aria-label="Instructor Hub">{nav.map(([href,label,icon])=><a href={href} aria-current={(Astro.url.pathname===href||(href!==withBase('/instructor/')&&Astro.url.pathname.startsWith(href)))?'page':undefined}><Icon name={icon}/>{label}</a>)}</nav><details class="nav-extra"><summary>Altri strumenti</summary><nav class="nav" aria-label="Altri strumenti">{extra.map(([href,label,icon])=><a href={href}><Icon name={icon}/>{label}</a>)}</nav></details></aside><main class="hubmain" id="contenuto"><slot/></main></div></body></html>
