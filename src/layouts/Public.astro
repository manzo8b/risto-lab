---import {withBase} from '../lib/urls';

import '../styles/global.css';
import '../styles/learning-colors.css';
import {brand} from '../data/public';
import ManzoSignature from '../components/ManzoSignature.astro';
import '../styles/manzo-signature.css';
import '../styles/contact-header.css';
import ContactHeader from '../components/ContactHeader.astro';
import professionalStyles from '../styles/professional.css?url';
import whiteEcosystemStyles from '../styles/white-ecosystem.css?url';
import editorialStyles from '../styles/editorial-v3.css?url';
import academyStyles from '../styles/academy-v4.css?url';
const {title='RISTO-LAB'}=Astro.props;
const nav=[[withBase('/'),'Home'],[withBase('/formazione/'),'Formazione'],[withBase('/programmi/'),'Programmi'],[withBase('/risorse/'),'Risorse'],[withBase('/premium/'),'Premium'],[withBase('/aziende/'),'Aziende'],[withBase('/esperienza/'),'Chi siamo'],[withBase('/area-docente/'),'Instructor']];
---
<!doctype html><html lang="it"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="RISTO-LAB — Hospitality Training & Restaurant Operations, by Marcelo Fernandez."/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site).href}/><link rel="icon" href={withBase("/favicon.svg")}/><title>{String(title).replace(/\.$/,'')} · RISTO-LAB</title></head><body class="rl-public"><link rel="stylesheet" href={professionalStyles}/><link rel="stylesheet" href={whiteEcosystemStyles}/><link rel="stylesheet" href={editorialStyles}/><link rel="stylesheet" href={academyStyles}/><a class="skip" href="#contenuto">Vai al contenuto</a><header class="topbar"><div class="wrap toprow"><a class="brand" href={withBase("/")}><img class="risto-brand-symbol" src={withBase("/brand/risto-lab-icon.webp")} width="42" height="42" alt="" aria-hidden="true"/><span class="risto-wordmark"><b>Risto-<span class="lab-accent">Lab</span></b><small>HOSPITALITY TRAINING</small></span></a><nav class="rl-desktop-nav" aria-label="Navigazione principale">{nav.map(([href,label])=><a href={href} class:list={[label==='Instructor'&&'rl-nav-cta']} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}</nav><details class="rl-mobile-menu"><summary aria-label="Apri il menu di navigazione">☰ Menu</summary><nav class="rl-mobile-links" aria-label="Navigazione mobile">{nav.map(([href,label])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}<a href={withBase('/contatti/')}>Contatti</a></nav></details></div><ContactHeader/></header><main id="contenuto"><slot/></main><footer class="footer"><div class="wrap"><div class="rl-footer-brand"><span class="academy-footer-logo"><img src={withBase("/brand/risto-lab-icon.webp")} width="54" height="54" alt="" loading="lazy"/><span><strong>Risto-<span class="lab-accent">Lab</span></strong><small>HOSPITALITY TRAINING</small></span></span><span>{brand.descriptor} · by {brand.creator}</span></div><ManzoSignature/></div></footer></body></html>
