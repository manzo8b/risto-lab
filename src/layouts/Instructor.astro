---import {withBase} from '../lib/urls';

import '../styles/global.css';
import '../styles/instructor.css';
import '../styles/learning-colors.css';
import '../styles/manzo-signature.css';
import '../styles/contact-header.css';
import ContactHeader from '../components/ContactHeader.astro';
import Profile from '../components/InstructorProfile.astro';
import Footer from '../components/InstructorFooter.astro';
import Breadcrumbs from '../components/InstructorBreadcrumbs.astro';
import Icon from '../components/Icon.astro';
import type {IconName} from '../lib/icons';
import {units,resources} from '../instructor/data/catalog';
const {title='Instructor Hub'}=Astro.props;
const routeUnit=units.find(u=>Astro.url.pathname===withBase('/instructor/unita/'+u.slug+'/'));
const routeResource=resources.find(r=>Astro.url.pathname===withBase('/instructor/risorse/'+r.id+'/'));
const aiHref=withBase('/instructor/ai/')+(routeResource?'?resource='+routeResource.id:routeUnit?'?unit='+routeUnit.id:Astro.url.pathname.includes('/normativa/')||Astro.url.pathname.includes('/sicurezza-alimentare/')?'?regulatory=1&task=research':'');
const nav:[string,string,IconName][]=[[withBase('/instructor/'),'Home','home'],[withBase('/instructor/programmi/'),'Programma','book'],[withBase('/instructor/sessioni/'),'Lezioni','layers'],[withBase('/instructor/biblioteca/'),'Biblioteca','file'],[withBase('/instructor/cerca/'),'Cerca','search'],[aiHref,'RISTO-LAB AI','tool'],[withBase('/instructor/aula/'),'Aula','screen']];
const inProgram=Astro.url.pathname.startsWith(withBase('/instructor/unita/'));
const inLibrary=Astro.url.pathname.startsWith(withBase('/instructor/risorse/'));
const extra:[string,string,IconName][]=[[withBase('/instructor/normativa/'),'Normativa','book'],[withBase('/instructor/laboratorio-sicurezza/'),'Laboratorio sicurezza','book'],[withBase('/instructor/raccolte/'),'Raccolte','layers'],[withBase('/instructor/sicurezza-alimentare/'),'Sicurezza Alimentare','book'],[withBase('/instructor/media/'),'Media','image']];
---
<!doctype html><html lang="it"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="RISTO-LAB: materiali, curriculum e strumenti per insegnare il servizio in sala."/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site).href}/><link rel="icon" href={withBase("/favicon.svg")}/><title>{String(title).replace(/\.$/,'')} · RISTO-LAB Docente</title></head><body class="instructor-shell"><a class="skip" href="#contenuto">Vai al contenuto</a><header class="topbar"><div class="wrap toprow"><a class="brand" href={withBase("/instructor/")}>RISTO<i>—</i>LAB<small>Instructor Hub</small></a><nav class="header-tools" aria-label="Accesso rapido"><a href={withBase('/instructor/cerca/')}><Icon name="search"/><span>Cerca</span></a><a href={aiHref} data-ai-entry><span aria-hidden="true">✦</span><span>RISTO-LAB AI</span></a><Profile/></nav></div><ContactHeader/></header><div class="hubbody"><aside class="sidebar" aria-label="Navigazione docente"><p class="eyebrow">Instructor Hub</p><nav class="nav" aria-label="Instructor Hub">{nav.map(([href,label,icon])=><a href={href} data-ai-entry={label==='RISTO-LAB AI'?true:undefined} aria-current={((inProgram&&label==='Programma')||(inLibrary&&label==='Biblioteca')||Astro.url.pathname===href.split('?')[0]||(href!==withBase('/instructor/')&&Astro.url.pathname.startsWith(href.split('?')[0])))?'page':undefined}><Icon name={icon}/>{label}</a>)}</nav><details class="nav-extra"><summary>Altri strumenti</summary><nav class="nav" aria-label="Altri strumenti">{extra.map(([href,label,icon])=><a href={href}><Icon name={icon}/>{label}</a>)}</nav></details></aside><div class="hubcontent"><main class="hubmain" id="contenuto"><Breadcrumbs title={title}/><slot/></main><Footer/></div></div><script>const contextParams=new URLSearchParams(location.search);document.querySelectorAll<HTMLAnchorElement>('[data-ai-entry]').forEach(a=>{const url=new URL(a.href);for(const key of ['unit','resource','q']){const value=contextParams.get(key);if(value)url.searchParams.set(key,value.slice(0,300));}if(location.pathname.includes('/sessioni/modifica/')){const id=contextParams.get('id');if(id)url.searchParams.set('session',id);}if(location.pathname.includes('/sessioni/'))url.searchParams.set('task','lesson');a.href=url.pathname+url.search;});</script></body></html>
