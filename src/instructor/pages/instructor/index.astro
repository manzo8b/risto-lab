---
import {withBase} from '../../../lib/urls';

import {currentInstructor,instructorGreeting} from '../../../lib/instructor-profile';
import Hub from '../../../layouts/Instructor.astro';
import {program,resources,units} from '../../data/catalog';

const lookup=JSON.stringify({resources:resources.map(r=>({id:r.id,title:r.title})),units:units.map(u=>({id:u.id,title:u.title,slug:u.slug}))}).replace(/</g,'\\u003c');
import Icon from '../../../components/Icon.astro';
---

<Hub title="Home Docente">
<div class="gourmet-dashboard">
  <section class="gourmet-hero" aria-labelledby="gourmet-main-heading">
    <div class="gourmet-hero-copy">
      <p class="gourmet-overline">RISTO-LAB <span aria-hidden="true">·</span> LA CARTA DEL DOCENTE</p>
      <h1 id="gourmet-main-heading">Ogni lezione<br/><em>ha il suo servizio.</em></h1>
      <p class="gourmet-hero-description">La precisione della sala incontra il metodo della formazione. Programma, materiali e strumenti: tutto pronto per progettare un’esperienza didattica curata nei dettagli.</p>
      <div class="gourmet-hero-actions">
        <a class="gourmet-cta gourmet-cta--gold" href={withBase("/instructor/programmi/il-servizio-in-sala/")}>Esplora il programma <Icon name="right"/></a>
        <a class="gourmet-cta gourmet-cta--outline" href={withBase("/instructor/sessioni/nuova/")}>Prepara una lezione <Icon name="right"/></a>
      </div>
      <p class="gourmet-hero-caption">MASTERCLASS DI SALA E OSPITALITÀ</p>

<section class="gourmet-carte" aria-labelledby="gourmet-carte-heading">
    <div class="gourmet-section-intro">
      <p class="gourmet-small-title"><span aria-hidden="true"></span> PERCORSO FORMATIVO <span aria-hidden="true"></span></p>
      <h2 id="gourmet-carte-heading">La carta del docente</h2>
      <p>Quattro strumenti per preparare, condurre e valutare ogni lezione.</p>
    </div>
    <nav class="quick-access gourmet-menu" aria-label="Strumenti principali del docente">
      <a href={withBase("/instructor/programmi/il-servizio-in-sala/")}>
        <span class="gourmet-menu-number" aria-hidden="true">01</span>
        <span class="eyebrow">Il programma</span>
        <h3>{program.title}</h3>
        <p>26 unità per comprendere, applicare e verificare i gesti del servizio <Icon name="right"/></p>
      </a>
      <a href={withBase("/instructor/unita/06-la-mise-en-place/")}>
        <span class="gourmet-menu-number" aria-hidden="true">02</span>
        <span class="eyebrow">Il dettaglio</span>
        <h3>La mise en place</h3>
        <p>Preparazione, ordine e materiali dell’unità 06 <Icon name="right"/></p>
      </a>
      <a href={withBase("/instructor/biblioteca/")}>
        <span class="gourmet-menu-number" aria-hidden="true">03</span>
        <span class="eyebrow">La biblioteca</span>
        <h3>I tuoi materiali</h3>
        <p>Testi, immagini e strumenti di supporto <Icon name="right"/></p>
      </a>
      <a href={withBase("/instructor/aula/")}>
        <span class="gourmet-menu-number" aria-hidden="true">04</span>
        <span class="eyebrow">La regia</span>
        <h3>Entra in aula</h3>
        <p>Sequenza didattica, presentazione e conduzione <Icon name="right"/></p>
      </a>
    </nav>
  </section>
<div class="gourmet-academy-strip"><span class="gourmet-academy-monogram" aria-hidden="true">RL</span><div><strong>ACADEMY RISTO-LAB</strong><p>Formazione d’eccellenza per la sala, il servizio e l’ospitalità.</p></div></div>
    </div>
    <figure class="gourmet-hero-media" aria-labelledby="gourmet-mise-title">
      <div class="gourmet-visual-heading"><p class="gourmet-visual-kicker">UNITÀ 06 · RISORSA DIDATTICA</p><h2 id="gourmet-mise-title">La mise en place</h2><p>Le sette fasi operative: osservare, preparare e verificare il servizio in sala.</p></div>
      <a class="gourmet-visual-link" href={withBase("/instructor/unita/06-la-mise-en-place/")} aria-label="Apri la lezione e la scheda sulla mise en place">
        <img src={withBase("/materiali/res-mep-image.webp")} alt="Infografica didattica sulle sette fasi operative della mise en place in sala" loading="eager" decoding="async"/>
      </a>
      <figcaption>Materiale illustrativo Risto-Lab · <a href={withBase("/instructor/unita/06-la-mise-en-place/")}>Apri l’unità 06 per leggere i contenuti <Icon name="right"/></a></figcaption>
    </figure>
  </section>

  <section class="gourmet-menu-study" aria-labelledby="gourmet-menu-study-title">
    <div><p class="eyebrow">Nuova mini-lezione · Progettazione gastronomica</p><h2 id="gourmet-menu-study-title">Menu Engineering <em>La radiografia del menù</em></h2><p>Dal menù confuso a quello chiaro: parole, prezzi, traduzione gastronomica, 14 allergeni UE, prodotti decongelati e margini. Un esercizio che unisce sala, cucina e gestione.</p></div>
    <a class="gourmet-cta gourmet-cta--gold" href={withBase("/instructor/menu-engineering/")}>Apri la lezione <Icon name="right"/></a>
  </section>
  <section class="gourmet-service" aria-labelledby="today-heading">
    <header class="work-heading gourmet-section-heading">
      <p class="eyebrow">La preparazione del servizio <span>·</span> Area docente</p>
      <h2>Il prossimo incontro</h2>
      <p class="lead">{instructorGreeting(currentInstructor)}. Organizza la tua prossima lezione, oppure riprendi da dove eri rimasto.</p>
    </header>
    <div class="work-surface today-session">
      <div class="section-heading">
        <div><p class="eyebrow">La lezione in primo piano</p><h3 id="today-heading">Lezione di oggi</h3></div>
        <a class="text-link" href={withBase("/instructor/sessioni/")}>Tutte le lezioni <Icon name="right"/></a>
      </div>
      <div id="today-plans"></div>
      <div class="empty-workspace">
        <h3>Parti dal programma, oppure prepara una lezione</h3>
        <p class="muted">Scegli tra le 26 unità del programma e adatta la sequenza Aula ai tuoi tempi.</p>
        <a class="button" href={withBase("/instructor/sessioni/nuova/?unit=unit-06")}><Icon name="plus"/> Crea lezione</a>
      </div>
      <div class="continue-teaching">
        <p id="resume-context" class="muted">Apri un’unità e inizia dai suoi materiali approvati.</p>
        <div class="hero-actions">
          <a id="resume" class="button" hidden href={withBase("/instructor/aula/?unit=unit-06")}><Icon name="play"/> Riprendi lezione</a>
          <a id="start-lesson" class="button" href={withBase("/instructor/programmi/")}><Icon name="play"/> Avvia lezione</a>
        </div>
      </div>
    </div>
    <nav class="home-tools gourmet-home-tools" aria-label="Azioni rapide">
      <a class="button secondary" href={withBase("/instructor/sessioni/nuova/")}><Icon name="plus"/> Crea lezione</a>
      <a class="button secondary" href={withBase("/instructor/cerca/")}><Icon name="search"/> Cerca</a>
      <a class="text-link" href={withBase("/instructor/programmi/il-servizio-in-sala/")}>Programma <Icon name="right"/></a>
      <a class="text-link" href={withBase("/instructor/ai/")}>✦ Chiedi a RISTO-LAB</a>
    </nav>
  </section>

  <section class="section gourmet-recent" aria-labelledby="gourmet-recent-heading">
    <div class="section-heading"><div><p class="eyebrow">La selezione del docente</p><h2 id="gourmet-recent-heading">Materiali recenti</h2></div></div>
    <div class="recent-row">
      <div><p id="recent-unit" class="muted">Nessuna unità recente.</p><h3 id="recent-resource">Apri un materiale per ritrovarlo qui</h3></div>
      <a id="recent-link" class="button secondary" href={withBase("/instructor/unita/06-la-mise-en-place/")}>Esplora l’unità 06 <Icon name="right"/></a>
    </div>
    <ul id="recent-materials"></ul>
  </section>

  <section class="gourmet-declaration" aria-label="Il metodo Risto-Lab">
    <p class="gourmet-declaration-line" aria-hidden="true">✦</p>
    <blockquote>«L’ospitalità si insegna con cura, metodo e attenzione ai dettagli.»</blockquote>
    <p>Il nostro approccio · Risto-Lab</p>
  </section>

  <div class="gourmet-lower-grid">
    <section class="section gourmet-workshop" aria-labelledby="gourmet-workshop-title">
      <p class="eyebrow">Laboratorio pratico · 90 minuti</p>
      <h2 id="gourmet-workshop-title">La sicurezza non è una firma</h2>
      <p class="muted">Sei attività per applicare i principi fondamentali di sicurezza: slide, gioco di ruoli, telefonata gossip, vocabolario, cruciverba e quiz. Percorso di apprendimento non certificante.</p>
      <div class="actions">
        <a class="button secondary" href={withBase("/instructor/laboratorio-sicurezza/")}>Entra nel laboratorio <Icon name="right"/></a>
        <a class="text-link" href={withBase("/instructor/laboratorio-sicurezza/lezioni/")}>Percorso in cinque lezioni <Icon name="right"/></a>
      </div>
    </section>
    <section class="section home-secondary gourmet-regulatory" aria-labelledby="gourmet-reg-title">
      <div>
        <p class="eyebrow">Riferimenti professionali</p>
        <h2 id="gourmet-reg-title">Normativa</h2>
        <p class="muted">Fonti e stato di verifica nel loro contesto, perché la precisione professionale viene prima dell’improvvisazione.</p>
        <a class="text-link" href={withBase("/instructor/normativa/")}>Consulta i riferimenti <Icon name="right"/></a>
      </div>
    </section>
  </div>
</div>
<script type="application/json" id="home-lookup" set:html={lookup}/><script>
import {withBase} from '../../../lib/urls';
import {renderPlans} from '../../../lib/plan-list';renderPlans('#today-plans',true);
const lookup=JSON.parse(document.querySelector('#home-lookup')!.textContent!);try{sessionStorage.removeItem('risto-last');const last=JSON.parse(localStorage.getItem('risto-last-position')||'null');const unit=lookup.units.find((u:{id:string})=>u.id===last?.unit);const resource=lookup.resources.find((r:{id:string})=>r.id===last?.resourceId);if(unit&&resource){const href=withBase('/instructor/aula/?unit=')+encodeURIComponent(unit.id)+'&resource='+encodeURIComponent(resource.id)+(typeof last.stepId==='string'?'&step='+encodeURIComponent(last.stepId):'');const a=document.querySelector<HTMLAnchorElement>('#resume')!;a.hidden=false;a.href=href;document.querySelector('#start-lesson')?.classList.add('secondary');document.querySelector('#resume-context')!.textContent='Riprendi '+unit.title+' dal punto in cui eri rimasto.';document.querySelector('#recent-unit')!.textContent=unit.title;document.querySelector('#recent-resource')!.textContent=resource.title;const recent=document.querySelector<HTMLAnchorElement>('#recent-link')!;recent.href=href;recent.textContent='Riprendi';}const recentIds=JSON.parse(localStorage.getItem('risto-recent-resources')||'[]');for(const id of Array.isArray(recentIds)?recentIds.slice(0,5):[]){const r=lookup.resources.find((r:{id:string})=>r.id===id);if(!r)continue;const li=document.createElement('li'),a=document.createElement('a');a.textContent=r.title;a.href=withBase('/instructor/risorse/')+encodeURIComponent(r.id)+'/';li.append(a);document.querySelector('#recent-materials')?.append(li);}}catch{localStorage.removeItem('risto-last-position');}
</script></Hub>
