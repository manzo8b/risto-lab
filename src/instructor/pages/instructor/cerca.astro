---
import {withBase} from '../../../lib/urls';
import Hub from '../../../layouts/Instructor.astro';
import Library from '../../../components/Library.astro';
import {resources,units} from '../../data/catalog';
---
<Hub title="Cerca il materiale giusto."><p class="eyebrow">Strumenti docente</p><h1>Cerca il materiale giusto</h1><p class="muted">Titolo, descrizione, argomento, tipo e unità. Ricerca locale, senza servizi esterni.</p><Library resources={resources} units={units}/><p class="section">Non trovi quello che cerchi? <a id="search-ai" class="text-link" href={withBase('/instructor/ai/?task=research')}>✦ Chiedi a RISTO-LAB</a></p><script>import {withBase} from '../../../lib/urls';import {libraryFilterKeys} from '../../../lib/library-state';const q=document.querySelector<HTMLInputElement>('#query')!;const a=document.querySelector<HTMLAnchorElement>('#search-ai')!;const update=()=>{const url=new URL(withBase('/instructor/ai/?task=research'),location.origin);for(const key of libraryFilterKeys){const input=document.querySelector<HTMLInputElement|HTMLSelectElement>('#'+(key==='q'?'query':key));if(input?.value)url.searchParams.set(key,input.value);}a.href=url.pathname+url.search;document.querySelectorAll<HTMLAnchorElement>('[data-ai-entry]').forEach(link=>link.href=a.href);};q.addEventListener('input',update);document.querySelector('#search-form')?.addEventListener('change',update);document.querySelector('#clear')?.addEventListener('click',update);update();</script></Hub>