---
import Hub from '../../../../layouts/Instructor.astro';
import {units} from '../../../data/catalog';
import {withBase} from '../../../../lib/urls';
import {aiProvider} from '../../../../lib/ai-provider';
import {aiTasks} from '../../../../lib/ai-context';
const actions=[['activity','Prepara un’attività'],['quiz','Crea un quiz'],['explain','Spiegami questo'],['example','Dammi un esempio pratico'],['lesson','Prepara una lezione'],['research','Approfondisci'],['adapt','Adatta per A2–B1'],['free','Domanda libera']];
---
<Hub title="RISTO-LAB AI"><header class="work-heading"><p class="eyebrow">Approfondire e preparare</p><h1>RISTO-LAB AI</h1><p class="lead">Il tuo assistente per la formazione nella ristorazione</p><p class="muted prose">Parti da ciò che stai insegnando. La conversazione continua in ChatGPT con il plugin RISTO-LAB.</p></header>
<form id="ai-form" class="ai-composer"><section class="ai-context-card" aria-labelledby="ai-context-heading"><p class="eyebrow" id="ai-context-heading">Stai lavorando su</p><p id="ai-orientation" role="status"></p><details id="ai-context-editor"><summary>Cambia contesto</summary><div class="metadata-fields"><label>Unità<select id="ai-unit" aria-label="Unità"><option value="">Tutto il programma</option>{units.map(u=><option value={u.id}>{String(u.order).padStart(2,'0')} · {u.title}</option>)}</select></label><label>Materiale<select id="ai-resource" aria-label="Materiale"><option value="">Nessun materiale selezionato</option></select></label></div><button id="ai-detach-session" class="secondary" type="button" hidden>Usa solo unità e materiale</button></details></section>
<a id="ai-return" class="text-link" href={withBase('/instructor/')}>Torna alla Home</a>
<section class="ai-help" aria-labelledby="ai-help-heading"><h2 id="ai-help-heading">Come posso aiutarti?</h2><div class="ai-quick-actions">{actions.map(([task,label])=><button class="secondary" type="button" data-ai-task={task} aria-pressed="false">{label}</button>)}</div><select id="ai-task" aria-label="Cosa vuoi fare?" hidden>{Object.entries(aiTasks).map(([value,title])=><option value={value}>{title}</option>)}</select><p id="ai-example" class="muted"></p><label>Oppure chiedi liberamente<textarea id="ai-request" aria-label="La tua richiesta" rows="4" maxlength="6000" placeholder="Che cosa vorresti preparare o capire meglio?"></textarea></label></section>
<p id="ai-regulatory" class="muted" hidden>Per contenuti normativi verifica sempre le <a href={withBase('/instructor/normativa/')}>fonti ufficiali collegate</a>.</p>
<details id="ai-full-request" class="ai-full-request"><summary>Vedi richiesta completa</summary><label>Richiesta pronta da copiare<textarea id="ai-preview" rows="10" readonly></textarea></label></details>
<div class="ai-continuation"><button id="ai-copy" type="button">Continua con RISTO-LAB →</button><p id="ai-copy-status" role="status" aria-live="polite"></p><button id="ai-manual-copy" type="button" class="secondary" hidden>Copia manualmente</button><a class="button" id="ai-launch" href={aiProvider.launchUrl||aiProvider.fallbackUrl} target="_blank" rel="noopener noreferrer" hidden>Apri ChatGPT ↗</a></div>
<ol class="ai-instructions" aria-label="Continua in ChatGPT"><li><strong>Seleziona RISTO-LAB</strong><span>Apri ChatGPT e scegli il plugin RISTO-LAB.</span></li><li><strong>Copia la richiesta</strong><span>Il contesto è già incluso. Usa «Continua con RISTO-LAB».</span></li><li><strong>Incolla e invia</strong><span>Continua la conversazione con RISTO-LAB.</span></li></ol><p class="muted ai-disclosure">{aiProvider.instructions}</p><p class="muted ai-disclosure">Le proposte AI sono bozze da verificare. Nessun contenuto viene inserito automaticamente nella lezione.</p></form><script>import '../../../../lib/ai-client';</script></Hub>
