---
import {withBase} from '../../lib/urls';

import Public from '../../layouts/Public.astro';
import {areas} from '../../data/public';
---
<Public title="Hospitality Training"><div class="wrap"><section class="hero editorial-hero"><div><p class="eyebrow">RISTO-LAB · by Marcelo Fernandez</p><h1>Esperienza reale<br/>nella ristorazione.<br/><em>Formazione pratica</em></h1><p class="lead muted">Esperienza reale nella ristorazione trasformata in formazione pratica.</p><div class="actions"><a class="button" href={withBase("/formazione/")}>Scopri la formazione ↗</a><a class="text-link" href={withBase("/esperienza/")}>Il percorso professionale</a></div></div><div class="hero-art" aria-hidden="true"><div class="place"></div><span class="art-label">Il valore è nei dettagli.</span></div></section><section class="section story-bridge"><p class="eyebrow">Dall’esperienza al metodo</p><h2>Una sala funziona quando<br/>ogni gesto ha un perché</h2><p class="prose muted">Il lavoro sul campo incontra l’organizzazione del servizio, il coordinamento delle persone e la formazione. RISTO-LAB collega queste dimensioni con un approccio concreto e attento al contesto.</p><div class="journey"><span>Sala</span><span>Operations</span><span>Coordinamento</span><span>Formazione</span></div></section><section class="section"><div class="section-heading"><div><p class="eyebrow">Ambiti di lavoro</p><h2>Competenze che si incontrano</h2></div><a href={withBase("/esperienza/")}>Esplora gli ambiti ↗</a></div><div class="area-grid">{areas.map((a,i)=><div class="area-row"><span>0{i+1}</span><h3>{a}</h3></div>)}</div></section><section class="section public-feature"><div><p class="eyebrow">Il progetto formativo</p><h2>Il Servizio in Sala</h2><p class="muted">Il manuale madre dà struttura a un programma di 26 unità di curriculum. Una base per collegare comprensione del servizio, pratica e confronto.</p><a class="button secondary" href={withBase("/risto-lab/")}>Dentro RISTO-LAB ↗</a></div><div class="editorial-note"><p class="eyebrow">Una base concreta</p><p class="serif">Un programma strutturato.<br/>Materiali selezionati.<br/>La pratica al centro.</p><p class="muted">La disponibilità dei materiali cresce con la revisione editoriale. Un capitolo non diventa automaticamente una lezione web.</p></div></section><section class="section"><p class="eyebrow">L’approccio</p><h2>Spiegare. Mostrare. Far provare</h2><div class="grid"><article class="card"><p class="eyebrow">01 · Comprendere</p><h3>Un linguaggio accessibile</h3><p class="muted">Concetti e termini professionali collegati a situazioni riconoscibili.</p></article><article class="card"><p class="eyebrow">02 · Fare</p><h3>Pratica contestualizzata</h3><p class="muted">Esercizi e dimostrazioni adattati al servizio e al livello di partenza.</p></article><article class="card"><p class="eyebrow">03 · Rivedere</p><h3>Osservazione e verifica</h3><p class="muted">Confrontare il risultato, riconoscere le difficoltà e ripetere con criterio.</p></article></div><p style="margin-top:25px"><a href={withBase("/formazione/")}>Il metodo di formazione ↗</a></p></section><section class="section public-feature"><div><p class="eyebrow">Lo spazio del docente</p><h2>La lezione,<br/>con tutto a portata di mano</h2><p class="muted">L’Instructor Hub raccoglie programma e materiali in uno spazio docente pubblico per la conduzione in aula.</p><a class="button secondary" href={withBase("/area-docente/")}>Area docente ↗</a></div><div class="console-illustration" aria-label="Illustrazione dello spazio docente"><p class="eyebrow">RISTO-LAB / Aula</p><div class="illustration-line"></div><div class="illustration-line short"></div><div class="illustration-panel">Programma → Materiali → Aula</div></div></section><section class="contact-band"><p class="eyebrow">Partiamo dal contesto</p><h2>Ogni gruppo ha<br/>un punto di partenza</h2><a class="button" href={withBase("/contatti/")}>Parliamo di formazione ↗</a></section></div></Public>
