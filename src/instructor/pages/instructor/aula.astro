---
import {withBase} from '../../../lib/urls';

import '../../../styles/global.css';
import '../../../styles/instructor.css';
import Icon from '../../../components/Icon.astro';
import {units} from '../../data/catalog';
const unit=units.find(u=>u.order===6)!;const teaching={title:'',id:'',blocks:[]};const projector=false,error='';const json='{}';

---
<!doctype html><html lang="it"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>{projector?'Vista Aula':'Console Docente'} · {unit.title} · RISTO-LAB</title></head><body class:list={['aula',projector&&'projector']}><header class="aula-head"><div><span class="eyebrow">RISTO-LAB / Unità {String(unit.order).padStart(2,'0')}</span><p>{unit.title}</p>{teaching&&<p>{teaching.title}</p>}</div><div class="session-progress"><p id="resource-position"></p><span>{teaching?'Blocco ':'Passaggio '}</span><span id="step-label" aria-live="polite"></span><div class="progress-track"><span id="progress-fill"></span></div></div>{!projector&&<div class="actions"><a class="button secondary" href={withBase("/instructor/")}><Icon name="home"/>Home</a>{teaching&&<button id="complete-teaching" class="secondary">Concludi lezione</button>}<a id="exit-classroom" class="button secondary" href={teaching?withBase('/instructor/sessioni/')+teaching.id+'/':withBase('/instructor/unita/')+unit.slug+'/'}><Icon name="right"/>Esci</a></div>}</header>{error&&<p role="alert" class="notice">{error}</p>}<main class="aula-grid"><section class="stage" aria-label="Contenuto della sessione"><p id="kind" class="eyebrow"></p><h1 id="resource-title"></h1><div id="resource-body" class="reading"></div><figure id="visual" class="stage-visual" hidden><img id="stage-image" alt=""/></figure><div id="quiz" hidden><h2 id="question"></h2><ol class="options" id="options"></ol><div id="answer" class="answer" hidden role="status"></div><p id="explanation" hidden></p>{!projector&&<div class="quiz-controls"><button id="reveal" data-icon="✓" class="secondary" aria-expanded="false">Mostra risposta</button><button id="explain" class="secondary" hidden>Mostra spiegazione</button><button id="quiz-reset" class="secondary">Ricomincia quiz</button></div>}</div><p id="empty" hidden>Materiale in preparazione. Torna al programma e scegli un’unità con risorse disponibili.</p></section>{!projector&&<aside><p class="eyebrow">Console Docente</p><p id="next-orientation" class="muted"></p><p id="student-sees" role="status"></p>{teaching&&<a id="complete-unit" class="text-link" href={withBase('/instructor/aula/?unit=')+unit.id}>Unità completa ↗</a>}<div class="aula-support"><p id="projector-status" class="muted" role="status">Vista Aula: ○ Non aperta</p><button id="focus-projector" class="secondary" hidden>Porta in primo piano</button><button id="blank-projector" class="secondary">Schermo neutro</button><button id="zoom-image" class="secondary" hidden>Ingrandisci immagine</button><button id="notes-toggle" class="secondary" aria-expanded="false">Note docente</button><p id="notes" class="muted" hidden>Nessuna nota docente.</p><details id="teacher-reading" hidden><summary>Testo di riferimento docente</summary><div id="reading" class="reading"></div></details></div></aside>}</main>{!projector?<footer class="controls"><div class="navigation-controls">{teaching&&<div class="page-controls"><span id="page-position"></span><button id="page-previous" class="secondary">Pagina precedente</button><button id="page-next" class="secondary">Pagina successiva</button></div>}<button id="previous" class="secondary"><Icon name="left"/>Indietro</button><button id="next">Avanti<Icon name="right"/></button><button id="materials-toggle" class="secondary" aria-haspopup="dialog"><Icon name="layers"/>Materiali</button></div><div><button id="timer-toggle" class="secondary" aria-expanded="true" aria-controls="timer-panel"><Icon name="clock"/>Timer</button><div id="timer-panel" class="timer-controls"><label>Minuti<input type="number" id="timer-minutes" aria-label="Minuti" min="1" max="120" value="5" class="timer-input"/></label><output id="timer" class="timer" aria-label="Tempo rimanente">05:00</output><button id="timer-start" class="secondary">Avvia timer</button><button id="timer-reset" class="secondary">Reset</button><div class="timer-presets" aria-label="Durate rapide">{[5,10,15].map(n=><button class="preset" data-minutes={n}>{n} min</button>)}</div></div></div><div class="presentation-controls"><button id="open-projector" class="secondary"><Icon name="screen"/>Vista Aula</button><button id="fullscreen" class="secondary"><Icon name="fullscreen"/>Schermo intero</button><details id="shortcuts"><summary>Scorciatoie</summary><p>← / →: indietro / avanti<br/>Spazio: avvia o pausa timer, fuori dai controlli<br/>Esc: chiude Materiali o lo schermo intero<br/>+ / −: ingrandisce l’immagine</p></details></div></footer>:<p class="projector-hint">← → per cambiare passaggio · + / − per ingrandire le immagini</p>}{!projector&&<dialog id="materials-dialog" aria-labelledby="materials-heading"><div class="section-heading"><h2 id="materials-heading">{teaching?'Blocchi della lezione':'Materiali dell’unità'}</h2><button id="materials-close" class="secondary">× Chiudi</button></div><nav id="resource-list" class="aula-resources" aria-label="Risorse della sessione"></nav></dialog>}<div id="blank-screen" hidden aria-label="Schermo neutro"></div>{!projector&&teaching&&<script type="application/json" id="teaching-admin-data" set:html={JSON.stringify(teaching).replace(/</g,'\\u003c')}/>}<script type="application/json" id="classroom-data" set:html={json}/><script>import '../../../lib/classroom-client';</script></body></html>
