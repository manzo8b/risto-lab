---
import {withBase} from '../../../lib/urls';

import {currentInstructor,instructorGreeting} from '../../../lib/instructor-profile';
import Hub from '../../../layouts/Instructor.astro';
import {program,resources,units} from '../../data/catalog';

const lookup=JSON.stringify({resources:resources.map(r=>({id:r.id,title:r.title})),units:units.map(u=>({id:u.id,title:u.title,slug:u.slug}))}).replace(/</g,'\\u003c');
import Icon from '../../../components/Icon.astro';
---
<Hub title="Home Docente"><header class="work-heading"><p class="eyebrow">Home Docente</p><h1>{instructorGreeting(currentInstructor)}</h1><p class="lead">Cosa insegniamo oggi?</p></header>
<section class="work-surface today-session" aria-labelledby="today-heading"><div class="section-heading"><div><p class="eyebrow">Il tuo prossimo incontro</p><h2 id="today-heading">Lezione di oggi</h2></div><a class="text-link" href={withBase("/instructor/sessioni/")}>Tutte le lezioni <Icon name="right"/></a></div><div id="today-plans"></div><div class="empty-workspace"><h3>Parti dal programma, oppure prepara una lezione</h3><p class="muted">Le unità 06, 10 e 17 hanno una sequenza Aula pronta da adattare ai tuoi tempi.</p><a class="button" href={withBase("/instructor/sessioni/nuova/?unit=unit-06")}><Icon name="plus"/>Crea lezione</a></div><div class="continue-teaching"><p id="resume-context" class="muted">Apri un’unità e inizia dai suoi materiali approvati.</p><div class="hero-actions"><a id="resume" class="button" hidden href={withBase("/instructor/aula/?unit=unit-06")}><Icon name="play"/>Riprendi lezione</a><a id="start-lesson" class="button" href={withBase("/instructor/programmi/")}><Icon name="play"/>Avvia lezione</a></div></div></section>
<nav class="home-tools" aria-label="Azioni rapide"><a class="button secondary" href={withBase("/instructor/sessioni/nuova/")}><Icon name="plus"/>Crea lezione</a><a class="button secondary" href={withBase("/instructor/cerca/")}><Icon name="search"/>Cerca</a><a class="text-link" href={withBase("/instructor/programmi/il-servizio-in-sala/")}>Programma <Icon name="right"/></a><a class="text-link" href={withBase("/instructor/ai/")}>✦ Chiedi a RISTO-LAB</a></nav>
<section class="quick-access"><a href={withBase("/instructor/programmi/il-servizio-in-sala/")}><span class="eyebrow">Il programma</span><h3>{program.title}</h3><p>26 unità · Apri il curriculum <Icon name="right"/></p></a><a href={withBase("/instructor/unita/06-la-mise-en-place/")}><span class="eyebrow">Unità 06</span><h3>La mise en place</h3><p>La sequenza Aula e i materiali <Icon name="right"/></p></a><a href={withBase("/instructor/biblioteca/")}><span class="eyebrow">La biblioteca</span><h3>I tuoi materiali</h3><p>Testi, immagini e strumenti <Icon name="right"/></p></a></section>
<section class="section"><div class="section-heading"><div><p class="eyebrow">Riparti da qui</p><h2>Materiali recenti</h2></div></div><div class="recent-row"><div><p id="recent-unit" class="muted">Nessuna unità recente.</p><h3 id="recent-resource">Apri un materiale per ritrovarlo qui</h3></div><a id="recent-link" class="button secondary" href={withBase("/instructor/unita/06-la-mise-en-place/")}>Esplora l’unità 06 <Icon name="right"/></a></div><ul id="recent-materials"></ul></section>
<section class="section home-secondary"><div><p class="eyebrow">Riferimenti professionali</p><h2>Normativa</h2><p class="muted">Fonti e stato di verifica, nel loro contesto.</p><a class="text-link" href={withBase("/instructor/normativa/")}>Consulta i riferimenti <Icon name="right"/></a></div></section><script type="application/json" id="home-lookup" set:html={lookup}/><script>
import {withBase} from '../../../lib/urls';
import {renderPlans} from '../../../lib/plan-list';renderPlans('#today-plans',true);
const lookup=JSON.parse(document.querySelector('#home-lookup')!.textContent!);try{sessionStorage.removeItem('risto-last');const last=JSON.parse(localStorage.getItem('risto-last-position')||'null');const unit=lookup.units.find((u:{id:string})=>u.id===last?.unit);const resource=lookup.resources.find((r:{id:string})=>r.id===last?.resourceId);if(unit&&resource){const href=withBase('/instructor/aula/?unit=')+encodeURIComponent(unit.id)+'&resource='+encodeURIComponent(resource.id)+(typeof last.stepId==='string'?'&step='+encodeURIComponent(last.stepId):'');const a=document.querySelector<HTMLAnchorElement>('#resume')!;a.hidden=false;a.href=href;document.querySelector('#start-lesson')?.classList.add('secondary');document.querySelector('#resume-context')!.textContent='Riprendi '+unit.title+' dal punto in cui eri rimasto.';document.querySelector('#recent-unit')!.textContent=unit.title;document.querySelector('#recent-resource')!.textContent=resource.title;const recent=document.querySelector<HTMLAnchorElement>('#recent-link')!;recent.href=href;recent.textContent='Riprendi';}const recentIds=JSON.parse(localStorage.getItem('risto-recent-resources')||'[]');for(const id of Array.isArray(recentIds)?recentIds.slice(0,5):[]){const r=lookup.resources.find((r:{id:string})=>r.id===id);if(!r)continue;const li=document.createElement('li'),a=document.createElement('a');a.textContent=r.title;a.href=withBase('/instructor/risorse/')+encodeURIComponent(r.id)+'/';li.append(a);document.querySelector('#recent-materials')?.append(li);}}catch{localStorage.removeItem('risto-last-position');}
</script></Hub>
