---import {withBase} from '../lib/urls';

import '../styles/global.css';
import '../styles/learning-colors.css';
import {brand} from '../data/public';
const {title='RISTO-LAB'}=Astro.props;
const nav=[[withBase('/'),'Home'],[withBase('/esperienza/'),'Esperienza'],[withBase('/formazione/'),'Formazione'],[withBase('/risto-lab/'),'RISTO-LAB'],[withBase('/contatti/'),'Contatti'],[withBase('/area-docente/'),'Area Docente']];
---
<!doctype html><html lang="it"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="RISTO-LAB — Hospitality Training & Restaurant Operations, by Marcelo Fernandez."/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site).href}/><link rel="icon" href={withBase("/favicon.svg")}/><title>{String(title).replace(/\.$/,'')} · RISTO-LAB</title></head><body><a class="skip" href="#contenuto">Vai al contenuto</a><header class="topbar"><div class="wrap toprow"><a class="brand" href={withBase("/")}>RISTO<i>—</i>LAB<small>Hospitality · Training · Operations</small></a><nav class="nav" aria-label="Principale">{nav.map(([href,label])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}</nav></div></header><main id="contenuto"><slot/></main><footer class="footer"><div class="wrap"><span>{brand.descriptor} · by {brand.creator}</span><span>MARCELUS AI LAB</span></div></footer></body></html>
