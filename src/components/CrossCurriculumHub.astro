---
import SourceText from './SourceText.astro';
import {resources,units} from '../instructor/data/catalog';
import registry from '../instructor/data/cross-curriculum.json';
import {withBase} from '../lib/urls';
const {kind}=Astro.props as {kind:'scenario'|'lab'};
const entries=kind==='scenario'?registry.scenarios:registry.labs;
const unitId=kind==='scenario'?'unit-24':'unit-25';
---
<section class="section cross-curriculum-hub" id="pratica" data-hub={kind}>
 <h2>{kind==='scenario'?'Scegli una simulazione':'Scegli un laboratorio'}</h2>
 <p class="prose muted">{kind==='scenario'?'Ogni scheda richiama un’attività già approvata. Scegli un obiettivo, distribuisci ruoli e informazioni e concludi con un nuovo tentativo. I livelli indicano complessità del caso, non una classifica delle persone.':'Scegli in base ai materiali disponibili. I minuti indicano un giro con dimostrazione, pratica e confronto; il laboratorio integrale resta nel capitolo della fonte.'}</p>
 {entries.map(entry=>{const resource=resources.find(r=>r.id===entry.resource_id)!;const origin=units.find(u=>resource.unit_ids.includes(u.id))!;return <details class="card cross-card" data-cross={entry.id}>
  <summary><strong>{entry.title}</strong><span class="muted">{'level' in entry?`Livello ${entry.level} · `:''}{entry.minutes} min</span><span class="disclosure-indicator" aria-hidden="true"></span></summary>
  {'setting' in entry?<><h3>Contesto e ruoli</h3><p>{entry.setting}</p><p>{entry.roles}</p><h3>Obiettivo e condizioni iniziali</h3><p>{entry.objective}</p><p>{entry.initial_conditions}</p><h3>Evento o problema</h3><p>{entry.event}</p><h3>Vincoli della prova</h3><p>{entry.constraints}</p></>:<><h3>Obiettivo operativo</h3><p>{entry.objective}</p><h3>Partecipanti e materiali</h3><p>{entry.participants}</p><p>{entry.materials}</p><h3>Preparazione e briefing del docente</h3><p>{entry.setup}</p><p>{entry.briefing}</p><h3>Errori da riconoscere nella conduzione</h3><ul>{entry.common_errors.map(error=><li>{error}</li>)}</ul><h3>Con meno attrezzatura</h3><p>{entry.alternative}</p><h3>Risultato da osservare</h3><p>{entry.success}</p></>}
  <h3>Prima della prova</h3><p class="prerequisites">{entry.prerequisites.map(id=>{const u=units.find(u=>u.id===id)!;return <a href={withBase('/instructor/unita/')+u.slug+'/'}>{String(u.order).padStart(2,'0')} · {u.title}</a>})}</p>
  <h3>Procedura, osservazione e debrief</h3><p class="muted">{resource.description}</p><SourceText text={resource.reading||resource.body||resource.sections?.map(s=>s.title+'\n'+s.items.join('\n')).join('\n\n')||''}/>
  <div class="actions"><a class="button secondary" href={withBase('/instructor/aula/?unit=')+origin.id+'&resource='+resource.id}>Mostra la prova in Aula ↗</a><a class="button secondary" href={withBase('/instructor/risorse/')+resource.id+'/'}>Apri la scheda canonica ↗</a><a class="text-link" href={withBase('/instructor/risorse/')+entry.observer_resource_id+'/'}>Scheda osservatore ↗</a><a class="text-link" href={withBase('/instructor/ai/?unit=')+unitId+'&resource='+resource.id+'&task=activity'}>✦ Chiedi a RISTO-LAB su questa prova</a></div>
 </details>})}
</section>
<style>.cross-card{margin:1rem 0}.cross-card summary{cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:1rem;min-height:44px}.cross-card summary strong{flex:1}.disclosure-indicator::before{content:"＋";color:var(--deep-teal);font-size:1.25rem}.cross-card[open] .disclosure-indicator::before{content:"−"}.cross-card[open] summary{margin-bottom:1.5rem}.cross-card h3{margin-top:1.5rem}.prerequisites{display:flex;flex-wrap:wrap;gap:.6rem 1rem}.cross-card .actions{margin-top:1.5rem}@media(max-width:600px){.cross-card summary{align-items:flex-start;flex-wrap:wrap}.cross-card summary strong{flex-basis:100%}.cross-card summary .disclosure-indicator{margin-left:auto}.cross-card{padding:1rem}}</style>
