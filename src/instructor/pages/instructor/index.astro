---
import {withBase} from '../../../lib/urls';

import {currentInstructor,instructorGreeting} from '../../../lib/instructor-profile';
import Hub from '../../../layouts/Instructor.astro';
import {program,resources,units} from '../../data/catalog';

const lookup=JSON.stringify({resources:resources.map(r=>({id:r.id,title:r.title})),units:units.map(u=>({id:u.id,title:u.title,slug:u.slug}))}).replace(/</g,'\\u003c');
import Icon from '../../../components/Icon.astro';
---

<Hub title="Dashboard Instructor">
<div class="academy-dash">
 <header class="academy-welcome">
  <div><p class="eyebrow">RISTO-LAB · SPAZIO DOCENTE</p><h1>Progetta, insegna, fai crescere le competenze</h1><p>{instructorGreeting(currentInstructor)}. Un solo ambiente per i materiali, la pratica e la conduzione delle lezioni.</p></div>
  <a class="button" href={withBase('/instructor/sessioni/nuova/')}>＋ Crea una lezione</a>
 </header>
 <div class="academy-overview">
  <section class="academy-banner" aria-labelledby="academy-hero-heading">
    <div class="academy-banner-copy"><p class="eyebrow" style="color:#fff!important">HOSPITALITY TRAINING</p><h2 id="academy-hero-heading">Progetta esperienze formative<br/>per i professionisti dell’ospitalità</h2><div class="academy-banner-points"><span>26 unità curricolari</span><span>Risorse professionali</span><span>Didattica pratica</span></div></div>
    <img src={withBase('/materiali/res-mep-table.webp')} alt="Risorsa illustrata Risto-Lab per la preparazione della tavola" width="480" height="330" loading="eager"/>
  </section>
  <section class="academy-stat-card" aria-labelledby="academy-stats-heading">
   <h2 id="academy-stats-heading">Il patrimonio formativo</h2>
   <div class="academy-stat-grid">
    <div><span class="academy-stat-icon" aria-hidden="true">▤</span><strong>{units.length}</strong><small>Unità curricolari</small></div>
    <div><span class="academy-stat-icon" aria-hidden="true">▣</span><strong>{resources.length}</strong><small>Risorse catalogate</small></div>
    <div><span class="academy-stat-icon" aria-hidden="true">✓</span><strong>5</strong><small>Lezioni aperte sulla sicurezza</small></div>
   </div>
   <p style="font-size:12px;color:#435372;margin-top:17px">Dati del curriculum, non statistiche sugli studenti</p>
  </section>
 </div>
 <section class="gourmet-carte" aria-labelledby="academy-navigation-heading">
  <h2 id="academy-navigation-heading" style="font-size:22px;margin:0 0 15px">I tuoi strumenti di lavoro</h2>
  <nav class="academy-launch-grid quick-access gourmet-menu" aria-label="Strumenti principali">
   <a class="academy-launch" href={withBase('/instructor/programmi/il-servizio-in-sala/')}><div class="academy-launch-head"><span aria-hidden="true">▱</span><b>Programmi</b></div><div class="academy-launch-body"><p>Le 26 unità del Servizio in Sala e il percorso da progettare</p><small>Apri il programma ↗</small></div></a>
   <a class="academy-launch" href={withBase('/instructor/biblioteca/')}><div class="academy-launch-head"><span aria-hidden="true">▤</span><b>Biblioteca</b></div><div class="academy-launch-body"><p>178 risorse catalogate, schede e materiali per le lezioni</p><small>Esplora le risorse ↗</small></div></a>
   <a class="academy-launch" href={withBase('/instructor/aula/')}><div class="academy-launch-head"><span aria-hidden="true">◉</span><b>Aula</b></div><div class="academy-launch-body"><p>Presentazioni e sequenze per la conduzione didattica</p><small>Apri l'Aula ↗</small></div></a>
   <a class="academy-launch" href={withBase('/instructor/sessioni/')}><div class="academy-launch-head"><span aria-hidden="true">▦</span><b>Sessioni</b></div><div class="academy-launch-body"><p>Prepara lezioni e riprendi le bozze salvate nel browser</p><small>Le tue sessioni ↗</small></div></a>
   <a class="academy-launch" href={withBase('/instructor/programmi/')}><div class="academy-launch-head"><span aria-hidden="true">◇</span><b>Unità</b></div><div class="academy-launch-body"><p>24 unità predisposte per l'aula e 2 ancora parziali</p><small>Sfoglia le unità ↗</small></div></a>
  </nav>
 </section>
 <div class="academy-feature-grid">
   <section class="academy-featured" aria-labelledby="academy-featured-title">
     <figure class="gourmet-hero-media" style="margin:0;min-width:0"><a href={withBase('/instructor/unita/06-la-mise-en-place/')} aria-label="Apri La mise en place"><img src={withBase('/materiali/res-mep-image.webp')} width="450" height="380" alt="Infografica sulla preparazione e controllo del coperto" loading="lazy"/></a></figure>
     <div><span class="academy-label">Unità 06 · In revisione</span><h2 id="academy-featured-title">La mise en place</h2><p>Preparazione della tavola, controllo dei dettagli e verifica pratica con il docente</p><div class="academy-tagline"><span>12 slide</span><span>Laboratorio</span><span>Obiettivi osservabili</span></div><p><strong>Stato:</strong> PARTIAL — validazione pedagogica ancora da completare</p><a class="button" href={withBase('/instructor/unita/06-la-mise-en-place/')}>Apri l’unità ↗</a></div>
   </section>
   <section class="academy-toolbox" aria-labelledby="academy-tools-title">
    <h2 id="academy-tools-title">Strumenti didattici pratici</h2><p>Collegamenti a funzioni e materiali realmente disponibili</p>
    <div class="academy-tools">
      <a href={withBase('/instructor/sessioni/nuova/')}><span aria-hidden="true">▣</span><strong>Crea lezione</strong><small>Componi la sequenza e scegli risorse</small></a>
      <a href={withBase('/instructor/laboratorio-sicurezza/')}><span aria-hidden="true">◇</span><strong>Laboratorio</strong><small>Attività e casi di sicurezza</small></a>
      <a href={withBase('/instructor/unita/26-verifica-finale/')}><span aria-hidden="true">✓</span><strong>Valutazione</strong><small>Consulta il modello finale</small></a>
      <a href={withBase('/instructor/ai/')}><span aria-hidden="true">✦</span><strong>Supporto AI</strong><small>Prepara idee e materiali da revisionare</small></a>
    </div>
   </section>
 </div>
 <section class="academy-library" aria-labelledby="academy-library-heading">
   <h2 id="academy-library-heading">Biblioteca risorse</h2><p>Accedi a materiali selezionati per il servizio e la formazione professionale</p>
   <div class="academy-library-links">
    <a href={withBase('/instructor/biblioteca/')}><span aria-hidden="true">▤</span> Biblioteca completa</a>
    <a href={withBase('/instructor/menu-engineering/')}><span aria-hidden="true">♧</span> Menu Engineering</a>
    <a href={withBase('/instructor/laboratorio-sicurezza/lezioni/')}><span aria-hidden="true">◈</span> Sicurezza</a>
    <a href={withBase('/instructor/normativa/')}><span aria-hidden="true">▣</span> Normativa</a>
   </div>
 </section>
 <section class="academy-recent" aria-labelledby="today-heading">
  <div class="section-heading"><div><p class="eyebrow">WORKSPACE DOCENTE</p><h2 id="today-heading">Riprendi il tuo lavoro</h2></div><a class="text-link" href={withBase('/instructor/sessioni/')}>Tutte le lezioni ↗</a></div>
  <div class="work-surface today-session">
    <div id="today-plans"></div>
    <div class="empty-workspace"><h3>Prepara la prossima lezione</h3><p class="muted">Scegli tra le 26 unità del programma e adatta la sequenza Aula ai tuoi tempi</p><a class="button" href={withBase('/instructor/sessioni/nuova/?unit=unit-06')}>＋ Crea lezione</a></div>
    <div class="continue-teaching"><p id="resume-context" class="muted">Apri un’unità e inizia dai suoi materiali approvati</p><div class="hero-actions"><a id="resume" class="button" hidden href={withBase('/instructor/aula/?unit=unit-06')}>Riprendi lezione</a><a id="start-lesson" class="button secondary" href={withBase('/instructor/programmi/')}>Apri il programma</a></div></div>
  </div>
  <div class="gourmet-menu-study" style="margin:16px 0"><div><p class="eyebrow">MICRO-LEZIONE</p><h2>La radiografia del menù</h2><p>Analizza ingredienti, lingua, allergeni e costi con un esempio gastronomico guidato</p></div><a class="button secondary" href={withBase('/instructor/menu-engineering/')}>Apri la lezione ↗</a></div>
  <div class="recent-row"><div><p id="recent-unit" class="muted">Nessuna unità recente</p><h3 id="recent-resource">Apri un materiale per ritrovarlo qui</h3></div><a id="recent-link" class="button secondary" href={withBase('/instructor/unita/06-la-mise-en-place/')}>Esplora unità 06</a></div>
  <ul id="recent-materials"></ul>
  <nav class="home-tools" aria-label="Accessi rapidi"><a class="button secondary" href={withBase('/instructor/cerca/')}>Cerca</a><a class="button secondary" href={withBase('/instructor/biblioteca/')}>Biblioteca</a><a class="button secondary" href={withBase('/instructor/raccolte/')}>Raccolte</a></nav>
 </section>
</div>
<script type="application/json" id="home-lookup" set:html={lookup}/><script>
import {withBase} from '../../../lib/urls';
import {renderPlans} from '../../../lib/plan-list';renderPlans('#today-plans',true);
const lookup=JSON.parse(document.querySelector('#home-lookup')!.textContent!);try{sessionStorage.removeItem('risto-last');const last=JSON.parse(localStorage.getItem('risto-last-position')||'null');const unit=lookup.units.find((u:{id:string})=>u.id===last?.unit);const resource=lookup.resources.find((r:{id:string})=>r.id===last?.resourceId);if(unit&&resource){const href=withBase('/instructor/aula/?unit=')+encodeURIComponent(unit.id)+'&resource='+encodeURIComponent(resource.id)+(typeof last.stepId==='string'?'&step='+encodeURIComponent(last.stepId):'');const a=document.querySelector<HTMLAnchorElement>('#resume')!;a.hidden=false;a.href=href;document.querySelector('#start-lesson')?.classList.add('secondary');document.querySelector('#resume-context')!.textContent='Riprendi '+unit.title+' dal punto in cui eri rimasto.';document.querySelector('#recent-unit')!.textContent=unit.title;document.querySelector('#recent-resource')!.textContent=resource.title;const recent=document.querySelector<HTMLAnchorElement>('#recent-link')!;recent.href=href;recent.textContent='Riprendi';}const recentIds=JSON.parse(localStorage.getItem('risto-recent-resources')||'[]');for(const id of Array.isArray(recentIds)?recentIds.slice(0,5):[]){const r=lookup.resources.find((r:{id:string})=>r.id===id);if(!r)continue;const li=document.createElement('li'),a=document.createElement('a');a.textContent=r.title;a.href=withBase('/instructor/risorse/')+encodeURIComponent(r.id)+'/';li.append(a);document.querySelector('#recent-materials')?.append(li);}}catch{localStorage.removeItem('risto-last-position');}
</script></Hub>
